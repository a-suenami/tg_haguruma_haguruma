# Haguruma fly.io Configuration Template
# Copy this to project root as fly.toml and customize
# DO NOT commit fly.toml to git

app = 'haguruma-YOUR_NAME'
primary_region = 'nrt'

[build]
  # Uses existing Dockerfile

[http_service]
  internal_port = 80
  force_https = true
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 0
  processes = ['app']

[[vm]]
  memory = '512mb'
  cpu_kind = 'shared'
  cpus = 1

# Optional: Add health check
# [http_service.checks]
#   interval = "30s"
#   timeout = "5s"
#   path = "/up"
