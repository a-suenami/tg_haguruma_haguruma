<ul class="uk-breadcrumb">
  <li>
    <%= link_to 'テナント', ruler_area_tenants_path %>
  </li>
  <li>
    <%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %>
  </li>
  <li>
    <%= link_to 'コンテンツモデル', ruler_area_tenant_content_models_path(@tenant) %>
  </li>
  <li>
    <span><%= @content_type.display_name %></span>
  </li>
</ul>

<%= form_with model: @content_type, url: ruler_area_tenant_content_model_path(@tenant, @content_type), local: true, data: { turbo: false } do |f| %>
  <%= f.hidden_field :tenant_id, value: @tenant.id %>
  <%= f.hidden_field :display_name, id: 'hidden-display-name' %>
  <%= f.hidden_field :description, id: 'hidden-description' %>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="margin: 0;"><%= @content_type.display_name %></h3>
    <div>
      <%= f.submit '保存する', class: 'uk-button uk-button-primary' %>
    </div>
  </div>

  <div class="uk-grid" uk-grid>
    <!-- Main content -->
    <div class="uk-width-expand">
      <!-- Hidden inputs for existing fields -->
      <div id="hidden-fields-container" style="display: none;">
        <%= f.fields_for :fields do |field_form| %>
          <% unique_id = field_form.object.id || "new_#{field_form.object.object_id}" %>
          <div data-field-id="<%= unique_id %>">
            <%= field_form.hidden_field :id %>
            <%= field_form.hidden_field :tenant_id, value: @tenant.id %>
            <%= field_form.hidden_field :label %>
            <%= field_form.hidden_field :api_identifier %>
            <%= field_form.hidden_field :description %>
            <%= field_form.hidden_field :field_type %>
            <%= field_form.hidden_field :required %>
            <%= field_form.hidden_field :position %>
            <%= field_form.hidden_field :_destroy, class: 'field-destroy-input' %>
          </div>
        <% end %>
      </div>

      <!-- Fields display table -->
      <% if @content_type.fields.any? %>
        <table class="uk-table uk-table-divider uk-table-small">
          <thead>
            <tr>
              <th style="width: 40px;"></th>
              <th>識別子</th>
              <th>名前</th>
              <th>種別</th>
              <th style="width: 40px;"></th>
            </tr>
          </thead>
          <tbody id="fields-table-body" uk-sortable="handle: .drag-handle">
            <% @content_type.fields.sort_by(&:position).each do |field| %>
              <% unique_id = field.id || "new_#{field.object_id}" %>
              <tr data-field-id="<%= unique_id %>">
                <td class="uk-text-center">
                  <a href="#" uk-icon="icon: menu" class="drag-handle" style="cursor: move;"></a>
                </td>
                <td>
                  <code><%= field.api_identifier %></code>
                  <% if field.required? %>
                    <span style="color: #f0506e; font-weight: bold; margin-left: 3px;">*</span>
                  <% end %>
                </td>
                <td>
                  <%= field.label %>
                  <% if field.description.present? %>
                    <br><small class="uk-text-muted"><%= field.description %></small>
                  <% end %>
                </td>
                <td>
                  <span uk-icon="icon: <%= field.field_type == 'text' ? 'pencil' : 'file-edit' %>"></span>
                  <%= field.field_type == 'text' ? 'ショートテキスト' : 'リッチテキスト' %>
                </td>
                <td class="uk-text-center">
                  <a href="#" uk-icon="icon: more-vertical"></a>
                  <div uk-dropdown="mode: click">
                    <ul class="uk-nav uk-dropdown-nav">
                      <li>
                        <a href="#" onclick="editField(event, '<%= unique_id %>', '<%= field.field_type %>', '<%= j(field.api_identifier) %>', '<%= j(field.label) %>', '<%= j(field.description.to_s) %>', <%= field.required? %>)">
                          <span uk-icon="icon: pencil; ratio: 0.8"></span> 編集
                        </a>
                      </li>
                      <li>
                        <a href="#" onclick="confirmRemoveField(event, '<%= unique_id %>')" style="color: #f0506e;">
                          <span uk-icon="icon: trash; ratio: 0.8"></span> 削除
                        </a>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div id="empty-fields-message" class="uk-text-center uk-text-muted uk-margin">
          <p>フィールドがまだありません</p>
          <p>「フィールドを追加」ボタンからフィールドを追加してください</p>
        </div>
      <% end %>

      <div class="uk-margin">
        <button type="button" class="uk-button uk-button-default" uk-toggle="target: #field-type-modal">
          + 新しいフィールドを追加する
        </button>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="uk-width-1-4@m">
      <div class="uk-card uk-card-default uk-card-body uk-card-small">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
          <div class="uk-text-bold">コンテンツモデル</div>
          <a href="#" uk-icon="icon: pencil" onclick="openMetadataModal(event)"></a>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">識別子</div>
          <div><code><%= @content_type.unique_name %></code></div>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">名前</div>
          <div><%= @content_type.display_name %></div>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">説明</div>
          <div><%= @content_type.description.presence || '-' %></div>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">多言語</div>
          <div>無効</div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Fix for UIkit sortable on table rows */
    #fields-table-body .uk-sortable-drag {
      display: table;
      width: 100%;
      background: white;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
      table-layout: fixed;
    }

    #fields-table-body .uk-sortable-drag td {
      display: table-cell;
      padding: 10px;
      border: 1px solid #e5e5e5;
      vertical-align: middle;
    }

    #fields-table-body .uk-sortable-placeholder {
      opacity: 0.3;
    }
  </style>

  <%= render 'field_modal' %>
  <%= render 'field_metadata_modal' %>

  <!-- Content Model Metadata Edit Modal -->
  <div id="content-model-metadata-modal" uk-modal>
    <div class="uk-modal-dialog">
      <button class="uk-modal-close-default" type="button" uk-close></button>

      <div class="uk-modal-header">
        <h2 class="uk-modal-title">コンテンツモデルの編集</h2>
      </div>

      <div class="uk-modal-body">
        <div class="uk-margin">
          <label class="uk-form-label">名前</label>
          <div class="uk-form-controls">
            <input type="text" id="modal-display-name" class="uk-input" placeholder="例: ブログ記事" value="<%= @content_type.display_name %>">
          </div>
        </div>

        <div class="uk-margin">
          <label class="uk-form-label">説明</label>
          <div class="uk-form-controls">
            <textarea id="modal-description" class="uk-textarea" rows="3" placeholder="このコンテンツモデルの説明を入力してください"><%= @content_type.description %></textarea>
          </div>
        </div>

        <div class="uk-margin">
          <label class="uk-form-label">多言語</label>
          <div class="uk-form-controls">
            <label>
              <input type="checkbox" id="modal-multilingual" class="uk-checkbox" disabled>
              無効
            </label>
          </div>
        </div>
      </div>

      <div class="uk-modal-footer uk-text-right">
        <button class="uk-button uk-button-default uk-modal-close" type="button">キャンセル</button>
        <button class="uk-button uk-button-primary" type="button" onclick="updateContentModelMetadata()">保存する</button>
      </div>
    </div>
  </div>

  <script>
    // Initialize sortable event listener on page load
    document.addEventListener('DOMContentLoaded', function() {
      const tableBody = document.getElementById('fields-table-body');
      if (tableBody) {
        UIkit.util.on(tableBody, 'stop', function() {
          updateFieldPositions();
        });
      }
    });

    function openMetadataModal(event) {
      event.preventDefault();
      UIkit.modal('#content-model-metadata-modal').show();
    }

    function updateContentModelMetadata() {
      const displayName = document.getElementById('modal-display-name').value;
      const description = document.getElementById('modal-description').value;

      // Update hidden inputs that will be submitted with the form
      document.getElementById('hidden-display-name').value = displayName;
      document.getElementById('hidden-description').value = description;

      // Update page title
      const pageTitle = document.querySelector('h3');
      if (pageTitle) pageTitle.textContent = displayName;

      // Update sidebar display name (now nth-child(3) because of header div)
      const sidebarName = document.querySelector('.uk-card .uk-margin-small:nth-child(3) div:last-child');
      if (sidebarName) sidebarName.textContent = displayName;

      // Update sidebar description (now nth-child(4) because of header div)
      const sidebarDesc = document.querySelector('.uk-card .uk-margin-small:nth-child(4) div:last-child');
      if (sidebarDesc) sidebarDesc.textContent = description || '-';

      UIkit.modal('#content-model-metadata-modal').hide();
    }
  </script>
<% end %>
