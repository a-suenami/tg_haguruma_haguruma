<div class="am-page-header">
  <h3>Ruler一覧</h3>
  <div>
    <%= link_to '新規作成', new_ruler_area_ruler_path, class: 'uk-button uk-button-primary' %>
  </div>
</div>

<table class="uk-table">
  <thead>
    <tr>
      <th>メールアドレス</th>
      <th>名前</th>
      <th>作成日時</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if @rulers.empty? %>
      <tr>
        <td colspan="4" class="uk-text-center uk-text-muted">
          Rulerが登録されていません
        </td>
      </tr>
    <% else %>
      <% @rulers.each do |ruler| %>
        <tr>
          <td><%= ruler.email %></td>
          <td><%= ruler.name %></td>
          <td><%= ruler.created_at.strftime('%Y/%m/%d %H:%M') %></td>
          <td>
            <div class="uk-text-right">
              <%= link_to '編集', edit_ruler_area_ruler_path(ruler), class: 'uk-button uk-button-small uk-button-default uk-margin-small-right' %>
              <%= link_to '削除', ruler_area_ruler_path(ruler), method: :delete, data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: 'uk-button uk-button-small uk-button-danger' %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
