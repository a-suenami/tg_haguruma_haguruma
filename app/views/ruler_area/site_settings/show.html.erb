<ul class="uk-breadcrumb">
  <li><%= link_to 'テナント', ruler_area_tenants_path %></li>
  <li><%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %></li>
  <li><span>サイト設定</span></li>
</ul>

<div class="am-page-header">
  <h3>サイト設定</h3>
  <div>
    <%= link_to '編集', edit_ruler_area_tenant_site_setting_path(@tenant), class: 'uk-button uk-button-primary' %>
  </div>
</div>

<div class="uk-card uk-card-default uk-card-body uk-margin">
  <h4 class="uk-card-title">認証ボタンラベル</h4>
  <table class="uk-table uk-table-divider">
    <tbody>
      <tr>
        <th style="width: 200px;">ログインボタン</th>
        <td><%= @site_setting.login_label %></td>
      </tr>
      <tr>
        <th>新規登録ボタン</th>
        <td><%= @site_setting.signup_label %></td>
      </tr>
    </tbody>
  </table>
</div>

<%# PC Header Features - uses 'features' JSONB column %>
<div class="uk-card uk-card-default uk-card-body uk-margin">
  <h4 class="uk-card-title">機能設定・PCヘッダー</h4>
  <p class="uk-text-muted uk-text-small uk-margin-bottom">PCヘッダーに表示する機能の設定です。</p>
  <table class="uk-table uk-table-divider uk-table-small">
    <thead>
      <tr>
        <th>機能</th>
        <th>有効</th>
        <th>ラベル</th>
        <th>メニューラベル</th>
      </tr>
    </thead>
    <tbody>
      <% TenantSiteSettings::DEFAULT_FEATURES.each do |key, defaults| %>
        <% feature = @site_setting.send(:merged_features)[key] %>
        <tr>
          <td><span class="uk-label"><%= key.upcase %></span></td>
          <td>
            <% if feature['enabled'] %>
              <span class="uk-label uk-label-success">有効</span>
            <% else %>
              <span class="uk-label">無効</span>
            <% end %>
          </td>
          <td><%= feature['label'].presence || defaults['label'] %></td>
          <td><%= feature['menu_label'].presence || defaults['menu_label'] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# SP Menu - uses 'menu_items' JSONB column %>
<div class="uk-card uk-card-default uk-card-body uk-margin">
  <h4 class="uk-card-title">SPメニュー</h4>
  <p class="uk-text-muted uk-text-small uk-margin-bottom">スマートフォン用メニューの項目設定です。</p>
  <table class="uk-table uk-table-divider uk-table-small">
    <thead>
      <tr>
        <th style="width: 50px;">順序</th>
        <th>種別</th>
        <th>有効</th>
        <th>ラベル</th>
        <th>リンク先</th>
      </tr>
    </thead>
    <tbody>
      <% @site_setting.all_menu_items_for_form.each_with_index do |item, index| %>
        <% is_logout = item['key'] == 'logout' %>
        <tr>
          <td><%= index + 1 %></td>
          <% if item['type'] == 'feature' %>
            <td><span class="uk-label"><%= item['key'].upcase %></span></td>
            <td>
              <% if item['enabled'] %>
                <span class="uk-label uk-label-success">有効</span>
              <% else %>
                <span class="uk-label">無効</span>
              <% end %>
            </td>
            <td><%= item['label'] %></td>
            <td><code>/<%= item['key'] %></code></td>
          <% elsif is_logout %>
            <td>
              <span class="uk-label uk-label-danger">ログアウト</span>
              <span class="uk-text-muted uk-margin-small-left" uk-icon="icon: lock; ratio: 0.7" uk-tooltip="削除不可"></span>
            </td>
            <td>-</td>
            <td><%= item['label'] %></td>
            <td><code>/logout</code></td>
          <% else %>
            <td>
              <span class="uk-label uk-label-warning">カスタム</span>
              <code class="uk-text-small uk-margin-small-left"><%= item['key'] %></code>
            </td>
            <td>
              <% if item['enabled'] %>
                <span class="uk-label uk-label-success">有効</span>
              <% else %>
                <span class="uk-label">無効</span>
              <% end %>
            </td>
            <td><%= item['label'] %></td>
            <td>
              <% if item['url'].present? %>
                <a href="<%= item['url'] %>" target="_blank" rel="noopener">
                  <%= item['url'] %>
                  <span uk-icon="icon: link; ratio: 0.8"></span>
                </a>
              <% else %>
                -
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
