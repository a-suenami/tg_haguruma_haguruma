<ul class="uk-breadcrumb">
  <li>
    <%= link_to 'テナント', ruler_area_tenants_path %>
  </li>
  <li>
    <%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %>
  </li>
  <li>
    <span>コンテンツタイプ</span>
  </li>
</ul>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h3 style="margin: 0;">コンテンツタイプ一覧</h3>
  <div>
    <button type="button" class="uk-button uk-button-primary" id="create-button" onclick="createContentType()">新規作成</button>
  </div>
</div>

<div class="uk-margin">
  <input type="text" class="uk-input" placeholder="コンテンツタイプ名を検索..." style="max-width: 500px;">
</div>

<ul class="uk-tab" uk-tab>
  <li class="<%= 'uk-active' if @active_tab == 'collections' %>">
    <%= link_to 'Collection', ruler_area_tenant_content_types_path(@tenant, tab: 'collections') %>
  </li>
  <li class="<%= 'uk-active' if @active_tab == 'singletons' %>">
    <%= link_to 'Singleton', ruler_area_tenant_content_types_path(@tenant, tab: 'singletons') %>
  </li>
</ul>

<ul class="uk-switcher">
  <!-- Collection Tab -->
  <li class="<%= 'uk-active' if @active_tab == 'collections' %>">
    <% if @collections.any? %>
      <table class="uk-table uk-table-divider uk-table-hover">
        <thead>
          <tr>
            <th>識別子</th>
            <th>名前</th>
            <th>作成日時</th>
            <th>最終更新日時</th>
          </tr>
        </thead>
        <tbody>
          <% @collections.each do |content_type| %>
            <tr onclick="window.location='<%= ruler_area_tenant_content_type_path(@tenant, content_type) %>'" style="cursor: pointer;">
              <td><code><%= content_type.unique_name %></code></td>
              <td>
                <%= content_type.display_name %>
                <% if content_type.description.present? %>
                  <br><small class="uk-text-muted"><%= content_type.description %></small>
                <% end %>
              </td>
              <td><%= content_type.created_at.strftime('%Y/%m/%d %H:%M') %></td>
              <td><%= content_type.updated_at.strftime('%Y/%m/%d %H:%M') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="uk-text-center uk-margin-large uk-text-muted">
        <p>Collectionモデルがまだありません</p>
        <%= link_to '新規作成', new_ruler_area_tenant_content_type_path(@tenant, type: 'collection'), class: 'uk-button uk-button-primary uk-margin-small-top' %>
      </div>
    <% end %>
  </li>

  <!-- Singleton Tab -->
  <li class="<%= 'uk-active' if @active_tab == 'singletons' %>">
    <% if @singletons.any? %>
      <table class="uk-table uk-table-divider uk-table-hover">
        <thead>
          <tr>
            <th>識別子</th>
            <th>名前</th>
            <th>作成日時</th>
            <th>最終更新日時</th>
          </tr>
        </thead>
        <tbody>
          <% @singletons.each do |content_type| %>
            <tr onclick="window.location='<%= ruler_area_tenant_content_type_path(@tenant, content_type) %>'" style="cursor: pointer;">
              <td><code><%= content_type.unique_name %></code></td>
              <td>
                <%= content_type.display_name %>
                <% if content_type.description.present? %>
                  <br><small class="uk-text-muted"><%= content_type.description %></small>
                <% end %>
              </td>
              <td><%= content_type.created_at.strftime('%Y/%m/%d %H:%M') %></td>
              <td><%= content_type.updated_at.strftime('%Y/%m/%d %H:%M') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="uk-text-center uk-margin-large uk-text-muted">
        <p>Singletonモデルがまだありません</p>
        <%= link_to '新規作成', new_ruler_area_tenant_content_type_path(@tenant, type: 'singleton'), class: 'uk-button uk-button-primary uk-margin-small-top' %>
      </div>
    <% end %>
  </li>
</ul>

<script>
function createContentType() {
  // Find which tab is active
  const tabs = document.querySelectorAll('.uk-tab li');
  let activeTabIndex = 0;

  tabs.forEach((tab, index) => {
    if (tab.classList.contains('uk-active')) {
      activeTabIndex = index;
    }
  });

  // 0 = collections, 1 = singletons
  const type = activeTabIndex === 0 ? 'collection' : 'singleton';
  window.location.href = '<%= new_ruler_area_tenant_content_type_path(@tenant) %>?type=' + type;
}
</script>
