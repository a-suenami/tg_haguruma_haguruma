<ul class="uk-breadcrumb">
  <li>
    <%= link_to 'テナント', ruler_area_tenants_path %>
  </li>
  <li>
    <%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %>
  </li>
  <li>
    <%= link_to 'コンテンツタイプ', ruler_area_tenant_content_types_path(@tenant) %>
  </li>
  <li>
    <span><%= @content_type.display_name %></span>
  </li>
</ul>

<%= form_with model: @content_type,
              url: ruler_area_tenant_content_type_path(@tenant, @content_type),
              local: true,
              data: { turbo: false, controller: 'content-type-field' } do |f| %>
  <%= f.hidden_field :tenant_id, value: @tenant.id %>
  <%= f.hidden_field :display_name, data: { content_type_field_target: 'hiddenDisplayName' } %>
  <%= f.hidden_field :description, data: { content_type_field_target: 'hiddenDescription' } %>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="margin: 0;" data-content-type-field-target="pageTitle"><%= @content_type.display_name %></h3>
    <div>
      <%= f.submit '保存する', class: 'uk-button uk-button-primary' %>
    </div>
  </div>

  <div class="uk-grid" uk-grid>
    <!-- Main content -->
    <div class="uk-width-expand">
      <!-- Hidden inputs for existing fields -->
      <div data-content-type-field-target="hiddenFieldsContainer" style="display: none;">
        <%= f.fields_for :fields do |field_form| %>
          <% unique_id = field_form.object.id || "new_#{field_form.object.object_id}" %>
          <div data-field-id="<%= unique_id %>">
            <%= field_form.hidden_field :id %>
            <%= field_form.hidden_field :tenant_id, value: @tenant.id %>
            <%= field_form.hidden_field :label %>
            <%= field_form.hidden_field :api_identifier %>
            <%= field_form.hidden_field :description %>
            <%= field_form.hidden_field :field_type %>
            <%= field_form.hidden_field :required %>
            <%= field_form.hidden_field :position %>
            <%= field_form.hidden_field :_destroy, class: 'field-destroy-input' %>
            <% if field_form.object.select_field? && field_form.object.select.present? %>
              <%= field_form.fields_for :select do |select_form| %>
                <%= select_form.hidden_field :id %>
                <%= select_form.hidden_field :display_format %>
                <%= select_form.fields_for :options do |option_form| %>
                  <%= option_form.hidden_field :id %>
                  <%= option_form.hidden_field :display_name %>
                  <%= option_form.hidden_field :unique_name %>
                  <%= option_form.hidden_field :position %>
                  <%= option_form.hidden_field :status %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Fields display table -->
      <% if @content_type.fields.any? %>
        <table class="uk-table uk-table-divider uk-table-small">
          <thead>
            <tr>
              <th style="width: 40px;"></th>
              <th>識別子</th>
              <th>名前</th>
              <th>種別</th>
              <th style="width: 40px;"></th>
            </tr>
          </thead>
          <tbody data-content-type-field-target="fieldsTableBody" uk-sortable="handle: .drag-handle">
            <% @content_type.fields.sort_by(&:position).each do |field| %>
              <% unique_id = field.id || "new_#{field.object_id}" %>
              <tr data-field-id="<%= unique_id %>">
                <td class="uk-text-center">
                  <a href="#" uk-icon="icon: menu" class="drag-handle" style="cursor: move;"></a>
                </td>
                <td>
                  <code><%= field.api_identifier %></code>
                  <% if field.required? %>
                    <span style="color: #f0506e; font-weight: bold; margin-left: 3px;">*</span>
                  <% end %>
                </td>
                <td>
                  <%= field.label %>
                  <% if field.description.present? %>
                    <br><small class="uk-text-muted"><%= field.description %></small>
                  <% end %>
                </td>
                <td>
                  <%
                    icon = case field.field_type
                           when 'text' then 'pencil'
                           when 'richtext' then 'file-edit'
                           when 'media_asset' then 'image'
                           when 'select_field' then 'list'
                           else 'file'
                           end
                  %>
                  <span uk-icon="icon: <%= icon %>"></span>
                  <%= field.field_type_label %>
                </td>
                <td class="uk-text-center">
                  <a href="#" uk-icon="icon: more-vertical"></a>
                  <div uk-dropdown="mode: click">
                    <ul class="uk-nav uk-dropdown-nav">
                      <li>
                        <%
                          select_data = if field.select_field? && field.select.present?
                            {
                              display_format: field.select.display_format,
                              options: field.select.options.order(:position).map { |o|
                                { id: o.id, display_name: o.display_name, unique_name: o.unique_name, status: o.status, deletable: o.deletable? }
                              }
                            }.to_json
                          else
                            'null'
                          end
                        %>
                        <a href="#"
                           data-action="content-type-field#editField"
                           data-field-id="<%= unique_id %>"
                           data-field-type="<%= field.field_type %>"
                           data-identifier="<%= field.api_identifier %>"
                           data-name="<%= field.label %>"
                           data-description="<%= field.description.to_s %>"
                           data-required="<%= field.required? %>"
                           data-select-data="<%= select_data %>">
                          <span uk-icon="icon: pencil; ratio: 0.8"></span> 編集
                        </a>
                      </li>
                      <li>
                        <a href="#"
                           data-action="content-type-field#confirmRemoveField"
                           data-field-id="<%= unique_id %>"
                           style="color: #f0506e;">
                          <span uk-icon="icon: trash; ratio: 0.8"></span> 削除
                        </a>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div data-content-type-field-target="emptyFieldsMessage"
             class="uk-text-center uk-text-muted uk-margin">
          <p>フィールドがまだありません</p>
          <p>「フィールドを追加」ボタンからフィールドを追加してください</p>
        </div>
      <% end %>

      <div class="uk-margin">
        <button type="button" class="uk-button uk-button-default" uk-toggle="target: #field-type-modal">
          + 新しいフィールドを追加する
        </button>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="uk-width-1-4@m">
      <div class="uk-card uk-card-default uk-card-body uk-card-small">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
          <div class="uk-text-bold">コンテンツタイプ</div>
          <a href="#"
             uk-icon="icon: pencil"
             data-action="content-type-field#openMetadataModal"></a>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">識別子</div>
          <div><code><%= @content_type.unique_name %></code></div>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">名前</div>
          <div data-content-type-field-target="sidebarDisplayName"><%= @content_type.display_name %></div>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">説明</div>
          <div data-content-type-field-target="sidebarDescription"><%= @content_type.description.presence || '-' %></div>
        </div>

        <div class="uk-margin-small">
          <div class="uk-text-bold uk-text-small">多言語</div>
          <div>無効</div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Fix for UIkit sortable on table rows */
    [data-content-type-field-target="fieldsTableBody"] .uk-sortable-drag {
      display: table;
      width: 100%;
      background: white;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
      table-layout: fixed;
    }

    [data-content-type-field-target="fieldsTableBody"] .uk-sortable-drag td {
      display: table-cell;
      padding: 10px;
      border: 1px solid #e5e5e5;
      vertical-align: middle;
    }

    [data-content-type-field-target="fieldsTableBody"] .uk-sortable-placeholder {
      opacity: 0.3;
    }
  </style>

  <%= render 'field_modal' %>
  <%= render 'field_metadata_modal' %>

  <!-- Content Type Metadata Edit Modal -->
  <div id="content-type-metadata-modal"
       uk-modal="container: false"
       data-content-type-field-target="contentTypeMetadataModal">
    <div class="uk-modal-dialog">
      <button class="uk-modal-close-default" type="button" uk-close></button>

      <div class="uk-modal-header">
        <h2 class="uk-modal-title">コンテンツタイプの編集</h2>
      </div>

      <div class="uk-modal-body">
        <div class="uk-margin">
          <label class="uk-form-label">名前</label>
          <div class="uk-form-controls">
            <input type="text"
                   data-content-type-field-target="modalDisplayName"
                   class="uk-input"
                   placeholder="例: ブログ記事"
                   value="<%= @content_type.display_name %>">
          </div>
        </div>

        <div class="uk-margin">
          <label class="uk-form-label">説明</label>
          <div class="uk-form-controls">
            <textarea data-content-type-field-target="modalDescription"
                      class="uk-textarea"
                      rows="3"
                      placeholder="このコンテンツタイプの説明を入力してください"><%= @content_type.description %></textarea>
          </div>
        </div>

        <div class="uk-margin">
          <label class="uk-form-label">多言語</label>
          <div class="uk-form-controls">
            <label>
              <input type="checkbox" class="uk-checkbox" disabled>
              無効
            </label>
          </div>
        </div>
      </div>

      <div class="uk-modal-footer uk-text-right">
        <button class="uk-button uk-button-default uk-modal-close" type="button">キャンセル</button>
        <button class="uk-button uk-button-primary"
                type="button"
                data-action="content-type-field#updateContentTypeMetadata">保存する</button>
      </div>
    </div>
  </div>
<% end %>
