<ul class="uk-breadcrumb">
  <li><%= link_to 'テナント', ruler_area_tenants_path %></li>
  <li><%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %></li>
  <li><%= link_to 'カスタム変数', ruler_area_tenant_custom_variables_path(@tenant) %></li>
  <li><span>新規作成</span></li>
</ul>

<div class="am-page-header">
  <h3>カスタム変数の新規作成</h3>
</div>

<%= form_with model: @custom_variable, url: ruler_area_tenant_custom_variables_path(@tenant), method: :post, local: true do |form| %>
  <%= render 'ruler_area/shared/form_error', target: @custom_variable %>

  <div class="uk-margin">
    <label class="uk-form-label">変数キー <span class="uk-text-danger">*</span></label>
    <div class="uk-form-controls">
      <%= form.text_field :unique_name,
          class: 'uk-input',
          placeholder: 'feature_flag_name',
          pattern: '[a-z_][a-z0-9_]*',
          title: '小文字英字・数字・アンダースコアのみ使用可能（先頭は英字またはアンダースコア）',
          required: true %>
      <p class="uk-text-muted uk-text-small uk-margin-small-top">小文字英字・数字・アンダースコアのみ使用可能</p>
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">タイプ <span class="uk-text-danger">*</span></label>
    <div class="uk-form-controls">
      <%= form.select :variable_type,
          options_for_select([
            ['フラグ（真偽値）', 'boolean'],
            ['日時', 'datetime'],
            ['テキスト', 'text']
          ], @custom_variable.variable_type || 'boolean'),
          {},
          class: 'uk-select' %>
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">説明</label>
    <div class="uk-form-controls">
      <%= form.text_field :description,
          class: 'uk-input',
          placeholder: 'この変数の用途を記入' %>
    </div>
  </div>

  <div class="uk-margin">
    <label class="uk-form-label">初期値 <span class="uk-text-danger">*</span></label>
    <div class="uk-form-controls">
      <div data-value-type="boolean">
        <div class="uk-margin-small">
          <label>
            <%= radio_button_tag 'site_custom_variable[boolean_value]', 'true', false, class: 'uk-radio' %>
            有効
          </label>
        </div>
        <div class="uk-margin-small">
          <label>
            <%= radio_button_tag 'site_custom_variable[boolean_value]', 'false', true, class: 'uk-radio' %>
            無効
          </label>
        </div>
      </div>
      <div data-value-type="datetime" style="display: none;">
        <%= datetime_field_tag 'site_custom_variable[datetime_value]', nil, class: 'uk-input' %>
      </div>
      <div data-value-type="text" style="display: none;">
        <%= text_area_tag 'site_custom_variable[text_value]', nil, class: 'uk-textarea', rows: 4, placeholder: 'テキストを入力' %>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const typeSelect = document.querySelector('select[name="site_custom_variable[variable_type]"]');
      const valueContainers = document.querySelectorAll('[data-value-type]');

      function updateValueInput() {
        const selectedType = typeSelect.value;
        valueContainers.forEach(function(container) {
          const isActive = container.dataset.valueType === selectedType;
          container.style.display = isActive ? '' : 'none';
          container.querySelectorAll('input, textarea').forEach(function(input) {
            input.disabled = !isActive;
          });
        });
      }

      typeSelect.addEventListener('change', updateValueInput);
      updateValueInput();
    })();
  </script>

  <div class="uk-margin">
    <%= form.submit '作成', class: 'uk-button uk-button-primary' %>
    <%= link_to 'キャンセル', ruler_area_tenant_custom_variables_path(@tenant), class: 'uk-button uk-button-default' %>
  </div>
<% end %>
