<div class="uk-flex uk-flex-center uk-flex-middle" style="min-height: 70vh;">
  <div class="uk-card uk-card-default uk-card-body uk-width-large">
    <div class="uk-text-center uk-margin-medium-bottom">
      <h2 class="uk-card-title uk-margin-remove">Ruler Area</h2>
      <p class="uk-text-muted">Super Administrator Login</p>
    </div>
    <div class="uk-margin-medium-top">
      <%= button_to '/auth/auth0',
          method: :post,
          class: 'uk-button uk-button-primary uk-width-1-1',
          data: { turbo: false } do %>
        <span uk-icon="icon: sign-in; ratio: 0.9" class="uk-margin-small-right"></span>
        Login with Auth0
      <% end %>
    </div>
  </div>
</div>
<style>
  .uk-button-primary {
    background-color: #1e87f0;
    color: #fff;
    transition: background-color 0.3s ease;
  }

  .uk-button-primary:hover {
    background-color: #0f7ae5;
  }
</style>
