<ul class="uk-breadcrumb">
  <li>
    <%= link_to 'テナント', ruler_area_tenants_path %>
  </li>
  <li>
    <%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %>
  </li>
  <li>
    <span>管理者</span>
  </li>
</ul>

<div class="am-page-header">
  <h3>管理者一覧</h3>
  <div>
    <%= link_to '新規作成', new_ruler_area_tenant_admin_path(@tenant), class: 'uk-button uk-button-primary' %>
  </div>
</div>

<table class="uk-table">
  <thead>
    <tr>
      <th>メールアドレス</th>
      <th>名前</th>
      <th>作成日時</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if @admins.empty? %>
      <tr>
        <td colspan="4" class="uk-text-center uk-text-muted">
          管理者が登録されていません
        </td>
      </tr>
    <% else %>
      <% @admins.each do |admin| %>
        <tr>
          <td><%= admin.email %></td>
          <td><%= admin.name %></td>
          <td><%= admin.created_at.strftime('%Y/%m/%d %H:%M') %></td>
          <td>
            <div class="uk-text-right">
              <%= link_to '編集', edit_ruler_area_tenant_admin_path(@tenant, admin), class: 'uk-button uk-button-small uk-button-default uk-margin-small-right' %>
              <%= link_to '削除', ruler_area_tenant_admin_path(@tenant, admin), method: :delete, data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: 'uk-button uk-button-small uk-button-danger' %>
            </div>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
