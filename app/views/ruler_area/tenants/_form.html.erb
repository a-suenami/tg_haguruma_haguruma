<div class="uk-margin">
  <%= f.label :id, class: 'uk-form-label' %>
  <div class="uk-form-controls">
    <%= f.text_field :id, required: true, class: 'form-stacked-text uk-input', disabled: f.object.persisted? %>
  </div>
</div>

<div class="uk-margin">
  <%= f.label :name, class: 'uk-form-label' %>
  <div class="uk-form-controls">
    <%= f.text_field :name, required: true, class: 'form-stacked-text uk-input' %>
  </div>
</div>

<div class="uk-margin">
  <%= f.label :user_page_domain, class: 'uk-form-label' %>
  <div class="uk-form-controls">
    <%= f.text_field :user_page_domain, placeholder: 'example.haguruma.com', required: false, class: 'form-stacked-text uk-input' %>
  </div>
</div>

