<div class="am-page-header">
  <h3>テナント一覧</h3>
  <div>
    <%= link_to '作成', new_ruler_area_tenant_path, class: 'uk-button uk-button-primary' %>
  </div>
</div>

<table class="uk-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>テナント名</th>
      <th>作成日時</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @tenants.each do |tenant| %>
      <tr>
        <td><%= tenant.id %></td>
        <td><%= tenant.name %></td>
        <td><%= tenant.created_at.strftime('%Y/%m/%d %H:%M') %></td>
        <td>
          <div class="uk-align-right">
            <% if tenant.user_page_domain.present? %>
              <%= link_to 'ユーザ画面', tenant.user_page_path, class: 'uk-button uk-button-small uk-button-default uk-margin-small-right', target: '_blank' %>
            <% else %>
              <button class="uk-button uk-button-small uk-button-default uk-margin-small-right" disabled>ユーザ画面</button>
            <% end %>
            <%= link_to '管理画面', '#', class: 'uk-button uk-button-small uk-button-default uk-margin-small-right', target: '_blank' %>
            <%= link_to '設定', ruler_area_tenant_path(tenant.id), class: 'uk-button uk-button-small uk-button-default uk-margin-small-right' %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

