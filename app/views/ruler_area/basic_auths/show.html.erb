<ul class="uk-breadcrumb">
  <li><%= link_to 'テナント', ruler_area_tenants_path %></li>
  <li><%= link_to @tenant.name, ruler_area_tenant_path(@tenant) %></li>
  <li><span>Basic認証</span></li>
</ul>

<div class="am-page-header">
  <h3>Basic認証</h3>
</div>

<style>
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
  }
  .toggle-switch-input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ccc;
    transition: 0.3s;
    border-radius: 22px;
  }
  .toggle-switch-slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }
  .toggle-switch-input:checked + .toggle-switch-slider {
    background-color: #1e87f0;
  }
  .toggle-switch-input:checked + .toggle-switch-slider:before {
    transform: translateX(18px);
  }
</style>

<div class="uk-card uk-card-default uk-card-body uk-margin">
  <h4 class="uk-card-title">設定</h4>

  <div class="uk-margin">
    <%= form_with model: @basic_auth, url: ruler_area_tenant_basic_auth_path(@tenant), method: :patch, local: true, scope: :basic_auth do |form| %>
      <label class="uk-flex uk-flex-middle" style="cursor: pointer;">
        <span class="toggle-switch">
          <%= form.check_box :enabled, class: 'toggle-switch-input', onchange: 'this.form.submit()' %>
          <span class="toggle-switch-slider"></span>
        </span>
        <span class="uk-margin-small-left">Basic認証を有効にする</span>
      </label>
    <% end %>
    <p class="uk-text-small uk-text-muted uk-margin-small-top">
      有効にすると、ユーザーサイトへのアクセス時にBasic認証が求められます。
    </p>
  </div>
</div>

<div class="uk-card uk-card-default uk-card-body uk-margin">
  <div class="uk-flex uk-flex-between uk-flex-middle">
    <h4 class="uk-card-title uk-margin-remove">認証情報</h4>
    <%= link_to new_ruler_area_tenant_basic_auth_credential_path(@tenant), class: 'uk-button uk-button-primary uk-button-small' do %>
      <span uk-icon="icon: plus; ratio: 0.8"></span> 追加
    <% end %>
  </div>

  <% if @basic_auth.credentials.any? %>
    <table class="uk-table uk-table-divider uk-table-middle uk-margin-top">
      <thead>
        <tr>
          <th style="width: 200px;">ユーザー名</th>
          <th>説明</th>
          <th style="width: 150px;">作成日</th>
          <th style="width: 120px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @basic_auth.credentials.order(created_at: :asc).each do |credential| %>
          <tr>
            <td><code><%= credential.username %></code></td>
            <td class="uk-text-muted"><%= credential.description.presence || '-' %></td>
            <td class="uk-text-small uk-text-muted"><%= credential.created_at.strftime('%Y/%m/%d') %></td>
            <td class="uk-text-right">
              <%= link_to edit_ruler_area_tenant_basic_auth_credential_path(@tenant, credential), class: 'uk-button uk-button-small uk-button-default' do %>
                <span uk-icon="icon: pencil; ratio: 0.7"></span>
              <% end %>
              <%= link_to ruler_area_tenant_basic_auth_credential_path(@tenant, credential), method: :delete, data: { turbo_method: :delete, turbo_confirm: 'この認証情報を削除しますか？' }, class: 'uk-button uk-button-small uk-button-danger' do %>
                <span uk-icon="icon: trash; ratio: 0.7"></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="uk-text-small uk-text-muted uk-margin-top">
      <span uk-icon="icon: info; ratio: 0.8"></span>
      パスワードはセキュリティのため表示できません。変更する場合は編集から再設定してください。
    </p>
  <% else %>
    <p class="uk-text-muted uk-margin-top">
      認証情報がまだ登録されていません。「追加」ボタンから登録してください。
    </p>
  <% end %>
</div>
