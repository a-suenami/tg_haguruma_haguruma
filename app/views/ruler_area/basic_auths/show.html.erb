          <td class="uk-text-small uk-text-muted">2025/01/20</td>
          <td class="uk-text-right">
            <button type="button" class="uk-button uk-button-small uk-button-default" disabled>
              <span uk-icon="icon: pencil; ratio: 0.7"></span>
            </button>
            <button type="button" class="uk-button uk-button-small uk-button-danger" disabled>
              <span uk-icon="icon: trash; ratio: 0.7"></span>
            </button>
          </td>
        </tr>
        <tr>
          <td><code>reviewer</code></td>
          <td class="uk-text-muted">レビュー担当者</td>
          <td class="uk-text-small uk-text-muted">2025/01/25</td>
          <td class="uk-text-right">
            <button type="button" class="uk-button uk-button-small uk-button-default" disabled>
              <span uk-icon="icon: pencil; ratio: 0.7"></span>
            </button>
            <button type="button" class="uk-button uk-button-small uk-button-danger" disabled>
              <span uk-icon="icon: trash; ratio: 0.7"></span>
            </button>
          </td>
        </tr>
        <tr>
          <td><code>client-a</code></td>
          <td class="uk-text-muted">クライアントA社</td>
          <td class="uk-text-small uk-text-muted">2025/01/27</td>
          <td class="uk-text-right">
            <button type="button" class="uk-button uk-button-small uk-button-default" disabled>
              <span uk-icon="icon: pencil; ratio: 0.7"></span>
            </button>
            <button type="button" class="uk-button uk-button-small uk-button-danger" disabled>
              <span uk-icon="icon: trash; ratio: 0.7"></span>
            </button>
          </td>
        </tr>
        <%# ===== /ダミーデータ ===== %>
      </tbody>
    </table>

    <p class="uk-text-small uk-text-muted uk-margin-top">
      <span uk-icon="icon: info; ratio: 0.8"></span>
      パスワードはセキュリティのため表示できません。変更する場合は編集から再設定してください。
    </p>
  </div>
<% end %>
