<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for(:title) || current_tenant&.name || 'Fan Club' %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300..900&family=Tsukimi+Rounded:wght@300;400;500;600;700&family=Zen+Maru+Gothic:wght@400;500;700;900&display=swap" rel="stylesheet">

  <style>
    <%= theme_css_style_tag %>
  </style>

  <%= vite_client_tag %>
  <%= vite_typescript_tag 'entrypoints/user_area/application' %>
  <%= vite_stylesheet_tag 'entrypoints/user_area/application.scss', skip_preload_tags: true %>
  <%= yield(:head) %>
</head>
<body cog-layout>
  <%= yield %>
</body>
</html>
