<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for(:title) || current_tenant&.name || 'User Area' %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= yield(:head) %>

  <style>
    :root {
      --primary-color: #3b82f6;
      --primary-hover: #2563eb;
      --text-color: #1f2937;
      --text-muted: #6b7280;
      --bg-color: #f9fafb;
      --card-bg: #ffffff;
      --border-color: #e5e7eb;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      line-height: 1.6;
    }

    .user-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .user-header {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .user-header-logo {
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--primary-color);
      text-decoration: none;
    }

    .user-header-nav {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .user-header-nav a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .user-header-nav a:hover {
      color: var(--primary-color);
    }

    .user-main {
      flex: 1;
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }

    .user-footer {
      background-color: var(--card-bg);
      border-top: 1px solid var(--border-color);
      padding: 1rem 2rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .flash {
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 0.5rem;
    }

    .flash-notice {
      background-color: #d1fae5;
      color: #065f46;
    }

    .flash-alert {
      background-color: #fee2e2;
      color: #991b1b;
    }

    .btn {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 0.375rem;
      text-decoration: none;
      cursor: pointer;
      border: none;
      font-size: 1rem;
      transition: background-color 0.2s;
    }

    .btn-primary {
      background-color: var(--primary-color);
      color: white;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
    }

    .btn-secondary {
      background-color: var(--border-color);
      color: var(--text-color);
    }

    .btn-secondary:hover {
      background-color: #d1d5db;
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 0.5rem;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>
  <div class="user-layout">
    <header class="user-header">
      <%= link_to current_tenant&.name || 'Home', user_area_root_path, class: 'user-header-logo' %>
      <nav class="user-header-nav">
        <% if user_signed_in? %>
          <%= link_to 'Contents', user_area_contents_path %>
          <%= link_to 'Profile', user_area_profile_path %>
          <%= button_to 'Logout', user_area_logout_path, method: :delete, class: 'btn btn-secondary' %>
        <% else %>
          <%= link_to 'Login', user_area_login_path, class: 'btn btn-primary' %>
        <% end %>
      </nav>
    </header>

    <main class="user-main">
      <%= render 'layouts/user_area/flash' %>
      <%= yield %>
    </main>

    <footer class="user-footer">
      &copy; <%= Time.current.year %> <%= current_tenant&.name %>. All rights reserved.
    </footer>
  </div>
</body>
</html>
