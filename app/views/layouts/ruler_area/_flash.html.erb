<script>
  document.addEventListener('turbo:load', async () => {
    const flash = <%= raw uikit_flash.to_json %>;
    flash.forEach(flash => {
      UIkit.notification({
        message: `<span uk-icon="icon: bell" style="margin-right: 0.2rem"></span> <div>${flash[1]}</div>`,
        status: flash[0],
        pos: 'top-center',
        timeout: 5000,
      });
    });
  }, { once: true });

  document.addEventListener('turbo:before-visit', async () => {
    UIkit.notification.closeAll();
    if (typeof Turbo !== 'undefined' && Turbo.cache) {
      Turbo.cache.clear();
    }
  });
</script>