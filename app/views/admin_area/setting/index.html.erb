<% content_for :title, '設定' %>

<main class="main">
    <header class="main-header">
        <h2>設定</h2>
        <button class="btn btn-primary">保存</button>
    </header>

    <div style="background: white; padding: 30px; border-radius: var(--border-radius); box-shadow: var(--shadow-sm);">
        <form>
            <h3 style="margin-bottom: 20px;">サイト設定</h3>

            <div class="form-group">
                <label class="form-label">サイト名</label>
                <input type="text" class="form-input" value="CMS サンプルサイト" placeholder="サイト名を入力">
            </div>

            <div class="form-group">
                <label class="form-label">サイトURL</label>
                <input type="text" class="form-input" value="https://example.com" placeholder="サイトURLを入力">
            </div>

            <div class="form-group">
                <label class="form-label">サイト説明</label>
                <textarea class="form-textarea" rows="3" placeholder="サイトの説明を入力">CMSのデモサイトです。様々なコンテンツを管理できます。</textarea>
            </div>

            <h3 style="margin-top: 40px; margin-bottom: 20px;">表示設定</h3>

            <div class="form-group">
                <label class="form-label">1ページあたりの表示件数</label>
                <input type="number" class="form-input" value="10" min="1" max="100">
            </div>

            <div class="form-group">
                <label class="form-label">日付フォーマット</label>
                <select class="form-input">
                    <option>YYYY-MM-DD</option>
                    <option>YYYY年MM月DD日</option>
                    <option>MM/DD/YYYY</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">設定を保存</button>
            </div>
        </form>
    </div>
</main>