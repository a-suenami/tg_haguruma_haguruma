<% content_for :title, 'メディアアップロード' %>

<div class="custom-container custom-container-no-sidebar">
  <main class="custom-main">
    <div class="breadcrumb">
      <%= link_to 'コンテンツ', admin_area_contents_all_path, class: 'breadcrumb-link' %>
      <span class="breadcrumb-separator">/</span>
      <%= link_to 'メディアライブラリ', admin_area_media_path, class: 'breadcrumb-link' %>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">アップロード</span>
    </div>

    <header class="main-header">
      <h2>メディアをアップロード</h2>
    </header>

    <% if @media_asset.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% @media_asset.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-container" data-controller="media-upload">
      <%= form_with url: admin_area_media_path, scope: :media_asset, local: true, multipart: true, class: 'content-form' do |form| %>
        <div class="upload-area"
             data-media-upload-target="uploadArea"
             data-action="dragover->media-upload#dragover dragleave->media-upload#dragleave drop->media-upload#drop">
          <div class="upload-icon">
            <i class="fas fa-cloud-upload-alt fa-4x"></i>
          </div>
          <p class="upload-text">ファイルをドラッグ＆ドロップ<br>または</p>
          <%= form.file_field :file, class: 'file-input', id: 'file-input', accept: 'image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx',
              data: { media_upload_target: 'fileInput', action: 'change->media-upload#selectFile' } %>
          <label for="file-input" class="btn btn-primary">
            <i class="fas fa-folder-open icon-prefix"></i>
            ファイルを選択
          </label>
          <p class="upload-hint">対応形式: 画像、動画、音声、PDF、Office文書</p>
        </div>

        <div style="display: none;" data-media-upload-target="filePreview">
          <div class="preview-card">
            <div class="preview-info">
              <p class="preview-filename" data-media-upload-target="filename"></p>
              <p class="preview-meta" data-media-upload-target="meta"></p>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" data-action="media-upload#clearFile">
              <i class="fas fa-times"></i>
              キャンセル
            </button>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary" data-media-upload-target="submitBtn" disabled>
            <i class="fas fa-upload icon-prefix"></i>アップロード
          </button>
          <%= link_to 'キャンセル', admin_area_media_path, class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
  </main>
</div>

<style>
.upload-area {
  border: 2px dashed var(--border-color, #e2e8f0);
  border-radius: 12px;
  padding: 3rem;
  text-align: center;
  background: var(--background-secondary, #f8fafc);
  transition: border-color 0.2s, background-color 0.2s;
  margin-bottom: 1.5rem;
}

.upload-area.dragover {
  border-color: var(--primary-color, #3b82f6);
  background: rgba(59, 130, 246, 0.05);
}

.upload-icon {
  color: var(--text-muted, #94a3b8);
  margin-bottom: 1rem;
}

.upload-text {
  color: var(--text-muted, #64748b);
  margin-bottom: 1rem;
}

.file-input {
  display: none;
}

.upload-hint {
  font-size: 0.75rem;
  color: var(--text-muted, #94a3b8);
  margin-top: 1rem;
  margin-bottom: 0;
}

.preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  background: var(--card-background, #fff);
  border: 1px solid var(--border-color, #e2e8f0);
  border-radius: 8px;
  margin-bottom: 1.5rem;
}

.preview-filename {
  font-weight: 500;
  margin: 0 0 0.25rem 0;
}

.preview-meta {
  font-size: 0.875rem;
  color: var(--text-muted, #64748b);
  margin: 0;
}
</style>
