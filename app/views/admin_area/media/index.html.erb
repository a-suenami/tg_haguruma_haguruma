<% content_for :title, 'メディア' %>

<main class="main">
    <header class="main-header">
        <h2>メディア</h2>
        <button class="btn btn-primary">アップロード</button>
    </header>

    <div class="content-filters">
        <input type="search" placeholder="検索..." class="search-input">
        <select class="filter-select">
            <option>すべて</option>
            <option>画像</option>
            <option>動画</option>
            <option>ドキュメント</option>
        </select>
    </div>

    <div style="padding: 40px; text-align: center; color: #94a3b8;">
        <p style="font-size: 18px; margin-bottom: 10px;">メディアライブラリは準備中です</p>
        <p>画像、動画、ドキュメントなどのファイルを管理できるようになります。</p>
    </div>
</main>