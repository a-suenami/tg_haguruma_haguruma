<% content_for :title, "#{@content_type.display_name}を編集" %>

<%
  # Determine current status
  current_status = if @draft_version
    '下書き'
  elsif @published_version
    '公開中'
  else
    '未保存'
  end
%>

<div class="custom-container">
  <%= render 'admin_area/contents/sidebar' %>

  <main class="custom-main">
    <!-- パンくずリスト -->
    <div class="breadcrumb">
      <%= link_to 'コンテンツ', admin_area_contents_all_path, class: 'breadcrumb-link' %>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current"><%= @content_type.display_name %></span>
    </div>

    <!-- シングルトンコンテンツの編集 -->
    <header class="content-detail-header">
      <div class="content-detail-title-section">
        <div class="content-title-with-back">
          <%= link_to admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: 'back-to-list-btn' do %>
            <i class="fas fa-arrow-left"></i>
          <% end %>
          <h1 class="content-detail-title"><%= @content_type.display_name %></h1>
        </div>
      </div>
    </header>

    <!-- バージョンタブ -->
    <div class="version-tabs">
      <%= link_to admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: "version-tab #{'disabled' unless @published_version}" do %>
        公開中
      <% end %>
      <%= link_to edit_admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: 'version-tab active' do %>
        編集中
      <% end %>
    </div>

    <% if flash[:notice].present? %>
      <div class="alert alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="alert alert-danger">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), method: :patch, class: 'content-form', local: true, id: 'content-entry-form' do %>
      <div class="content-detail-layout">
        <!-- メインコンテンツエリア -->
        <div class="content-main-area">
          <div class="content-form-area">
            <% if @content_type.fields.any? %>
              <% @content_type.fields.each do |field| %>
                <%= render 'admin_area/contents/field_input',
                           field: field,
                           value: @field_values[field.api_identifier],
                           content_type: @content_type,
                           content_entry: @content_entry %>
              <% end %>
            <% else %>
              <div class="empty-fields-message">
                <p>このコンテンツタイプにはフィールドが定義されていません。</p>
                <p>管理者にお問い合わせください。</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- 右側アクションパネル -->
        <div class="content-action-panel">
          <div class="action-section">
            <h4 class="action-section-title">ENTRY</h4>
            <div class="action-buttons">
              <button type="submit" class="btn btn-primary action-btn">
                <i class="fas fa-save icon-prefix"></i>
                保存
              </button>
              <%= link_to admin_area_contents_singleton_entry_publication_path(content_type_id: @content_type.id),
                          class: 'btn btn-success action-btn',
                          data: { turbo_method: :post } do %>
                <i class="fas fa-upload icon-prefix"></i>
                公開
              <% end %>
            </div>
          </div>

          <div class="action-section">
            <h4 class="action-section-title">PREVIEW</h4>
            <div class="action-buttons">
              <%= link_to '#', class: 'btn btn-secondary action-btn', target: '_blank' do %>
                <i class="fas fa-eye icon-prefix"></i>
                プレビュー
                <i class="fas fa-external-link-alt icon-suffix"></i>
              <% end %>
            </div>
          </div>

          <%= render 'admin_area/contents/authorization_tags',
                     authorization_tags: @authorization_tags,
                     selected_tag_id: @selected_authorization_tag_id,
                     is_public: @is_public,
                     save_url: admin_area_contents_singleton_entry_authorization_path(content_type_id: @content_type.id) %>

          <div class="action-section">
            <h4 class="action-section-title">META</h4>
            <div class="meta-info">
              <div class="meta-item">
                <span class="meta-key">ステータス:</span>
                <span class="action-panel-meta-value"><%= current_status %></span>
              </div>
              <div class="meta-item">
                <span class="meta-key">最終更新:</span>
                <span class="action-panel-meta-value">
                  <%= @content_entry.updated_at&.strftime('%Y-%m-%d %H:%M') || '-' %>
                </span>
              </div>
              <div class="meta-item">
                <span class="meta-key">作成日:</span>
                <span class="action-panel-meta-value">
                  <%= @content_entry.created_at&.strftime('%Y-%m-%d %H:%M') || '-' %>
                </span>
              </div>
              <% if @published_version&.published_at %>
                <div class="meta-item">
                  <span class="meta-key">公開日:</span>
                  <span class="action-panel-meta-value">
                    <%= @published_version.published_at.strftime('%Y-%m-%d %H:%M') %>
                  </span>
                </div>
              <% end %>
              <div class="meta-item">
                <span class="meta-key">コンテンツタイプ:</span>
                <span class="action-panel-meta-value"><%= @content_type.display_name %></span>
              </div>
              <% if @draft_version %>
                <div class="meta-item">
                  <span class="meta-key">バージョン:</span>
                  <span class="action-panel-meta-value">v<%= @draft_version.version %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </main>
</div>
