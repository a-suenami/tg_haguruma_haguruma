<% content_for :title, "#{@content_type.display_name}詳細" %>

<%
  # Determine current status
  current_status = if @published_version
    '公開中'
  elsif @draft_version
    '下書き'
  else
    '未保存'
  end
%>

<div class="custom-container">
  <%= render 'admin_area/contents/sidebar' %>

  <main class="custom-main">
    <!-- パンくずリスト -->
    <div class="breadcrumb">
      <%= link_to 'コンテンツ', admin_area_contents_all_path, class: 'breadcrumb-link' %>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current"><%= @content_type.display_name %></span>
    </div>

    <!-- シングルトンコンテンツの詳細表示 -->
    <header class="content-detail-header">
      <div class="content-detail-title-section">
        <div class="content-title-with-back">
          <%= link_to admin_area_contents_all_path, class: 'back-to-list-btn' do %>
            <i class="fas fa-arrow-left"></i>
          <% end %>
          <h1 class="content-detail-title"><%= @content_type.display_name %></h1>
        </div>
      </div>
    </header>

    <!-- バージョンタブ -->
    <div class="version-tabs">
      <%= link_to admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: 'version-tab active' do %>
        公開中
      <% end %>
      <%= link_to edit_admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: 'version-tab' do %>
        編集中
      <% end %>
    </div>

    <% if flash[:notice].present? %>
      <div class="alert alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="alert alert-danger">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @published_version || @draft_version %>
      <div class="content-detail-layout">
        <!-- メインコンテンツエリア -->
        <div class="content-main-area">
          <div class="content-form-area">
            <% if @content_type.fields.any? %>
              <% @content_type.fields.each do |field| %>
                <%= render 'admin_area/contents/field_display',
                           field: field,
                           value: @field_values[field.api_identifier] %>
              <% end %>
            <% else %>
              <div class="empty-fields-message">
                <p>このコンテンツタイプにはフィールドが定義されていません。</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- 右側アクションパネル -->
        <div class="content-action-panel">
          <div class="action-section">
            <h4 class="action-section-title">ENTRY</h4>
            <div class="action-buttons">
              <%= link_to edit_admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: 'btn btn-primary action-btn' do %>
                <i class="fas fa-edit icon-prefix"></i>
                編集
              <% end %>
            </div>
          </div>

          <%= render 'admin_area/contents/preview_buttons',
                     content_type: @content_type,
                     content_entry: @content_entry,
                     published_version: @published_version,
                     mode: :show %>

          <%= render 'admin_area/contents/authorization_tags_display',
                     selected_tags: @selected_authorization_tags,
                     visibility: @visibility %>

          <div class="action-section">
            <h4 class="action-section-title">META</h4>
            <div class="meta-info">
              <div class="meta-item">
                <span class="meta-key">ステータス:</span>
                <span class="action-panel-meta-value"><%= current_status %></span>
              </div>
              <% if @published_version&.published_at %>
                <div class="meta-item">
                  <span class="meta-key">公開日:</span>
                  <span class="action-panel-meta-value"
                        data-controller="datetime-local"
                        data-datetime-local-utc-value="<%= @published_version.published_at.utc.iso8601 %>">
                    <%= @published_version.published_at.strftime('%Y/%m/%d %H:%M') %>
                  </span>
                </div>
              <% end %>
              <% if @content_entry&.created_at %>
                <div class="meta-item">
                  <span class="meta-key">作成日:</span>
                  <span class="action-panel-meta-value"
                        data-controller="datetime-local"
                        data-datetime-local-utc-value="<%= @content_entry.created_at.utc.iso8601 %>">
                    <%= @content_entry.created_at.strftime('%Y/%m/%d %H:%M') %>
                  </span>
                </div>
              <% end %>
              <div class="meta-item">
                <span class="meta-key">コンテンツタイプ:</span>
                <span class="action-panel-meta-value"><%= @content_type.display_name %></span>
              </div>
              <% if @published_version %>
                <div class="meta-item">
                  <span class="meta-key">バージョン:</span>
                  <span class="action-panel-meta-value">v<%= @published_version.version %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="empty-content-message">
        <p>このコンテンツにはまだ公開されたバージョンがありません。</p>
        <%= link_to edit_admin_area_contents_singleton_entry_path(content_type_id: @content_type.id), class: 'btn btn-primary' do %>
          <i class="fas fa-edit icon-prefix"></i>
          編集を開始
        <% end %>
      </div>
    <% end %>
  </main>
</div>
