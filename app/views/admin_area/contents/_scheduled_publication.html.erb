<%# Scheduled publication inline UI for content entries %>
<%# Renders inside ENTRY section, right below publish button %>
<%# Required locals: draft_version, schedule_url, cancel_url %>

<% if defined?(draft_version) && draft_version %>
  <div class="scheduled-publication-inline" data-controller="scheduled-publication">
    <% if draft_version.scheduled? %>
      <!-- Currently scheduled -->
      <div class="scheduled-info-inline" data-scheduled-publication-target="scheduledInfo">
        <div class="scheduled-badge-inline">
          <i class="fas fa-clock"></i>
          <span>公開予約中</span>
        </div>
        <div class="scheduled-datetime-inline">
          <%= draft_version.scheduled_publish_at.strftime('%Y/%m/%d %H:%M') %>
        </div>
        <button type="button"
                class="btn btn-outline-danger btn-sm schedule-cancel-btn"
                data-action="scheduled-publication#cancel"
                data-scheduled-publication-url-value="<%= cancel_url %>">
          <i class="fas fa-times"></i>
          予約解除
        </button>
      </div>
    <% else %>
      <!-- Schedule form -->
      <div class="schedule-form-inline" data-scheduled-publication-target="scheduleForm">
        <label class="schedule-label">公開予約</label>
        <input type="datetime-local"
               class="schedule-datetime-input"
               data-scheduled-publication-target="datetimeInput"
               min="<%= Time.current.strftime('%Y-%m-%dT%H:%M') %>">
        <button type="button"
                class="btn btn-outline-secondary schedule-btn"
                data-action="scheduled-publication#schedule"
                data-scheduled-publication-url-value="<%= schedule_url %>">
          <i class="fas fa-calendar-check"></i>
          予約設定
        </button>
      </div>
    <% end %>

    <!-- Status messages -->
    <div class="schedule-message-inline" data-scheduled-publication-target="message" style="display: none;"></div>
  </div>
<% end %>
