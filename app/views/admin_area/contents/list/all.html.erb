<% content_for :title, 'コンテンツ管理' %>

<!-- モバイル用ハンバーガーメニューボタン -->
<button class="mobile-menu-toggle" id="mobile-menu-toggle">
    <i class="fas fa-bars"></i>
</button>

<!-- モバイル用オーバーレイ -->
<div class="mobile-overlay" id="mobile-overlay"></div>

<div class="custom-container">
    <%= render 'admin_area/contents/sidebar' %>

    <!-- メインコンテンツ -->
    <main class="custom-main">
        <!-- パンくずリスト -->
        <div class="breadcrumb">
            <span>コンテンツ</span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current" id="breadcrumb-current">すべて表示</span>
        </div>

        <header class="main-header">
            <h2 id="main-title">すべてのコンテンツ</h2>
        </header>

        <!-- フィルター -->
        <div class="content-filters">
            <input type="search" placeholder="コンテンツを検索..." class="search-input">
        </div>

        <!-- コレクション用カードリスト -->
        <div class="content-list" id="collection-content">
            <% collection_entries = @content_entries.select { |e| e.content_type.is_collection && e.versions.any? } %>
            <% if collection_entries.any? %>
                <% collection_entries.each do |entry| %>
                    <% latest_version = entry.versions.order(version: :desc).first %>

                    <%= link_to admin_area_contents_collection_entry_path(content_type_id: entry.content_type_id, id: entry.id), class: 'content-card-link' do %>
                        <div class="content-card">
                            <div class="card-header">
                                <div class="card-header-top">
                                    <span class="card-content-type"><%= entry.content_type.display_name %></span>
                                    <%= render 'admin_area/contents/status_badges', entry: entry %>
                                </div>
                                <h3 class="card-title">
                                    <% title_field = ContentEntry::Field.joins(:content_type_field).find_by(
                                        tenant_id: entry.tenant_id,
                                        content_type_id: entry.content_type_id,
                                        content_entry_id: entry.id,
                                        version: latest_version.version,
                                        content_type_fields: { api_identifier: 'title' }
                                    ) %>
                                    <% if title_field&.text %>
                                        <%= title_field.text.value %>
                                    <% else %>
                                        無題
                                    <% end %>
                                </h3>
                            </div>
                            <div class="card-meta">
                                <div class="card-meta-left">
                                    <div class="card-action-buttons">
                                        <% if latest_version.draft? %>
                                            <span class="btn btn-xs btn-edit"><i class="fas fa-edit icon-prefix"></i>編集</span>
                                            <span class="btn btn-xs btn-preview"><i class="fas fa-check-double icon-prefix"></i>プレビュー<i class="fas fa-external-link-alt icon-suffix"></i></span>
                                        <% elsif latest_version.published? %>
                                            <span class="btn btn-xs btn-external"><i class="fas fa-globe icon-prefix"></i>公開ページ<i class="fas fa-external-link-alt icon-suffix"></i></span>
                                            <span class="btn btn-xs btn-edit"><i class="fas fa-edit icon-prefix"></i>新しいバージョンを作成して編集</span>
                                        <% end %>
                                    </div>
                                </div>
                                <span class="card-updated"
                                      data-controller="datetime-local"
                                      data-datetime-local-utc-value="<%= latest_version.created_at.utc.iso8601 %>"><%= latest_version.created_at.strftime('%Y/%m/%d %H:%M') %></span>
                            </div>
                        </div>
                    <% end %>
                <% end %>
            <% else %>
                <div class="empty-state">
                    <i class="fas fa-inbox fa-4x" style="color: #94a3b8; margin-bottom: 1rem;"></i>
                    <p>コンテンツがまだ作成されていません。</p>
                </div>
            <% end %>
        </div>
    </main>
</div>

