<% content_for :title, 'コンテンツ編集' %>

<div class="custom-container">
    <!-- カスタムサイドバー -->
    <aside class="custom-sidebar">
        <div class="sidebar-content">
            <div class="sidebar-section">
                <ul class="tree-nav">
                    <!-- すべて表示 -->
                    <li class="tree-item">
                        <%= link_to admin_area_content_entries_path, class: 'tree-item-header' do %>
                            <span class="tree-toggle" style="visibility: hidden;"></span>
                            <span class="tree-label">すべて表示</span>
                            <span class="tree-count">3,502</span>
                        <% end %>
                    </li>

                    <!-- 区切り線 -->
                    <div class="tree-section-divider"></div>

                    <!-- 記事 -->
                    <li class="tree-item">
                        <div class="tree-item-header active" data-model="article">
                            <span class="tree-toggle expanded">▶</span>
                            <span class="tree-icon">📝</span>
                            <span class="tree-label">記事</span>
                            <span class="tree-count">892</span>
                        </div>
                        <ul class="tree-submenu expanded">
                            <li class="tree-submenu-item">
                                <%= link_to admin_area_content_entries_path, class: 'submenu-link' do %>
                                    すべての記事
                                <% end %>
                            </li>
                            <li class="tree-submenu-item">公開中 (687)</li>
                            <li class="tree-submenu-item">下書き (205)</li>
                            <li class="tree-submenu-item">+ 新規作成</li>
                        </ul>
                    </li>

                    <!-- 区切り線 -->
                    <div class="tree-section-divider"></div>

                    <!-- シングルコンテンツリンク -->
                    <li class="tree-item">
                        <%= link_to admin_area_content_entry_path(1, single: true, model: 'about'), class: 'tree-item-header' do %>
                            <span class="tree-icon">📄</span>
                            <span class="tree-label">会社概要</span>
                        <% end %>
                    </li>
                </ul>
            </div>
        </div>
    </aside>

    <!-- メインコンテンツ -->
    <main class="custom-main">
        <!-- パンくずリスト -->
        <div class="breadcrumb">
            <%= link_to 'コンテンツ', admin_area_content_entries_path, class: 'breadcrumb-link' %>
            <span class="breadcrumb-separator">/</span>
            <%= link_to '記事一覧', admin_area_content_entries_path, class: 'breadcrumb-link' %>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">2024年の技術トレンド予測</span>
        </div>

        <!-- コレクションコンテンツの編集 -->
        <header class="content-detail-header">
            <div class="content-detail-title-section">
                <div class="content-title-with-back">
                    <%= link_to admin_area_content_entry_path(params[:id]), class: 'back-to-list-btn' do %>
                        <i class="fas fa-arrow-left"></i>
                    <% end %>
                    <h1 class="content-detail-title">2024年の技術トレンド予測</h1>
                </div>
            </div>
        </header>

        <!-- バージョンタブ -->
        <div class="version-tabs">
            <%= link_to edit_admin_area_content_entry_path(params[:id]), class: 'version-tab active' do %>
                編集中
            <% end %>
            <%= link_to admin_area_content_entry_path(params[:id]), class: 'version-tab' do %>
                公開中
            <% end %>
        </div>

        <div class="content-detail-layout">
            <!-- メインコンテンツエリア -->
            <div class="content-main-area">

                <!-- コンテンツフィールド（編集中バージョン - editable form） -->
                <div class="content-form-area">
                    <%= form_with url: admin_area_content_entry_path(params[:id]), method: :patch, class: 'content-form' do |form| %>
                        <div class="field-group">
                            <%= form.label :title, 'title', class: 'field-label' %>
                            <%= form.text_field :title, value: '2024年の技術トレンド予測', class: 'field-input' %>
                        </div>

                        <div class="field-group">
                            <%= form.label :content, 'content', class: 'field-label' %>

                            <!-- React Lexical Rich Text Editor -->
                            <div data-controller="react-lexical"
                                 data-react-lexical-initial-content-value="<%= html_escape('<h2>AIの現状と課題（改訂版）</h2><p>2024年は人工知能（AI）技術の飛躍的な進歩が期待される年です。特に<strong>生成AI</strong>の分野では、より高精度で実用的なモデルが続々と登場し、ビジネスの様々な場面での活用が加速しています。また、<em>量子コンピューティング</em>の実用化も視野に入ってきました。</p><h3>注目すべき技術トレンド（追加）</h3><ul><li><strong>マルチモーダルAI</strong>: テキスト、画像、音声を統合的に処理</li><li><strong>エッジAI</strong>: デバイス上での軽量AI処理</li><li><strong>説明可能AI（XAI）</strong>: AI判断の透明性向上</li><li><strong>AI倫理とガバナンス</strong>: 責任あるAI開発</li><li><strong>量子AI</strong>: 量子コンピューティングとAIの融合 <span class="content-change-highlight">新規追加</span></li></ul><div class="content-note"><h4>📝 編集者ノート</h4><p>量子AIセクションを追加し、より包括的な内容に更新しました。最新の研究動向を反映しています。</p></div>') %>"
                                 data-react-lexical-placeholder-value="記事の内容を入力してください..."
                                 data-react-lexical-hidden-field-id-value="content_field">
                            </div>

                            <!-- Hidden field to store content for form submission -->
                            <%= form.hidden_field :content, id: "content_field" %>
                        </div>

                        <div class="field-group">
                            <%= form.label :author, 'author', class: 'field-label' %>
                            <%= form.text_field :author, value: '山田太郎', class: 'field-input' %>
                        </div>

                        <div class="field-group">
                            <%= form.label :category, 'category', class: 'field-label' %>
                            <%= form.select :category, [['技術', 'technology'], ['ビジネス', 'business'], ['デザイン', 'design']], { selected: 'technology' }, { class: 'field-select' } %>
                        </div>

                        <div class="field-group">
                            <%= form.label :tags, 'tags', class: 'field-label' %>
                            <%= form.text_field :tags, value: 'AI, 技術トレンド, 2024年, 量子コンピューティング', class: 'field-input' %>
                        </div>
                    <% end %>
                </div>
            </div>

            <!-- 右側アクションパネル（編集中タブ用） -->
            <div class="content-action-panel">
                <div class="action-section">
                    <h4 class="action-section-title">ENTRY</h4>
                    <div class="action-buttons">
                        <button type="submit" class="btn btn-secondary action-btn">
                            <i class="fas fa-save icon-prefix"></i>
                            保存
                        </button>
                        <button type="submit" class="btn btn-success action-btn">
                            <i class="fas fa-upload icon-prefix"></i>
                            公開
                        </button>
                    </div>
                </div>

                <div class="action-section">
                    <h4 class="action-section-title">PREVIEW</h4>
                    <div class="action-buttons">
                        <%= link_to '#', class: 'btn btn-secondary action-btn', target: '_blank' do %>
                            <i class="fas fa-eye icon-prefix"></i>
                            プレビュー
                            <i class="fas fa-external-link-alt icon-suffix"></i>
                        <% end %>
                    </div>
                </div>

                <div class="action-section">
                    <h4 class="action-section-title">META</h4>
                    <div class="meta-info">
                        <div class="meta-item">
                            <span class="meta-key">ステータス:</span>
                            <span class="action-panel-meta-value">編集中</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-key">最終更新:</span>
                            <span class="action-panel-meta-value">2024-01-16 10:30</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-key">作成者:</span>
                            <span class="action-panel-meta-value">山田太郎</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-key">文字数:</span>
                            <span class="action-panel-meta-value">約 3,200</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
