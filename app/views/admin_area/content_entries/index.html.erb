<% content_for :title, 'コンテンツ管理' %>

<div class="custom-container">
    <!-- カスタムサイドバー -->
    <aside class="custom-sidebar">
        <div class="sidebar-content">
            <!-- コンテンツセクション -->
            <div class="sidebar-section">
                <ul class="tree-nav">
                    <!-- すべて表示 -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="all">
                            <span class="tree-toggle" style="visibility: hidden;"></span>
                            <span class="tree-icon">🔀</span>
                            <span class="tree-label">すべて表示</span>
                            <span class="tree-count">3,502</span>
                        </div>
                    </li>

                    <!-- 区切り線 -->
                    <div class="tree-section-divider"></div>

                    <!-- 記事 -->
                    <li class="tree-item">
                        <div class="tree-item-header active" data-model="article">
                            <span class="tree-toggle expanded">▶</span>
                            <span class="tree-icon">📝</span>
                            <span class="tree-label">記事</span>
                            <span class="tree-count">892</span>
                        </div>
                        <ul class="tree-submenu expanded">
                            <li class="tree-submenu-item">すべての記事</li>
                            <li class="tree-submenu-item">公開中 (687)</li>
                            <li class="tree-submenu-item">下書き (205)</li>
                            <li class="tree-submenu-item">+ 新規作成</li>
                        </ul>
                    </li>

                    <!-- お知らせ -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="announcement">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">📢</span>
                            <span class="tree-label">お知らせ</span>
                            <span class="tree-count">145</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item">すべてのお知らせ</li>
                            <li class="tree-submenu-item">公開中 (98)</li>
                            <li class="tree-submenu-item">下書き (47)</li>
                            <li class="tree-submenu-item">+ 新規作成</li>
                        </ul>
                    </li>

                    <!-- 商品 -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="product">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">🛍️</span>
                            <span class="tree-label">商品</span>
                            <span class="tree-count">2,341</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item">すべての商品</li>
                            <li class="tree-submenu-item">販売中 (1,892)</li>
                            <li class="tree-submenu-item">在庫切れ (449)</li>
                            <li class="tree-submenu-item">+ 新規作成</li>
                        </ul>
                    </li>

                    <!-- プロフィール -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="profile">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">👤</span>
                            <span class="tree-label">プロフィール</span>
                            <span class="tree-count">48</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item">すべてのプロフィール</li>
                            <li class="tree-submenu-item">公開中 (42)</li>
                            <li class="tree-submenu-item">非公開 (6)</li>
                            <li class="tree-submenu-item">+ 新規作成</li>
                        </ul>
                    </li>

                    <!-- ギャラリー -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="gallery">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">📸</span>
                            <span class="tree-label">ギャラリー</span>
                            <span class="tree-count">76</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item">すべてのギャラリー</li>
                            <li class="tree-submenu-item">公開中 (65)</li>
                            <li class="tree-submenu-item">非公開 (11)</li>
                            <li class="tree-submenu-item">+ 新規作成</li>
                        </ul>
                    </li>

                    <!-- 区切り線 -->
                    <div class="tree-section-divider"></div>

                    <!-- 会社概要 (single) - b1: 編集中のみ -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="about" data-type="single" data-state="draft-only">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">📄</span>
                            <span class="tree-label">会社概要</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item" data-action="draft">下書き</li>
                        </ul>
                    </li>

                    <!-- プライバシーポリシー (single) - b2: 公開中のみ -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="privacy" data-type="single" data-state="published-only">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">🔒</span>
                            <span class="tree-label">プライバシーポリシー</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item" data-action="published">公開中</li>
                        </ul>
                    </li>

                    <!-- 利用規約 (single) - b3: 公開中＋編集中 -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="terms" data-type="single" data-state="both">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">📋</span>
                            <span class="tree-label">利用規約</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item" data-action="published">公開中</li>
                            <li class="tree-submenu-item" data-action="draft">下書き</li>
                        </ul>
                    </li>

                    <!-- お問い合わせページ (single) - 例: b1状態 -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="contact" data-type="single" data-state="draft-only">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">📮</span>
                            <span class="tree-label">お問い合わせ</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item" data-action="draft">下書き</li>
                        </ul>
                    </li>

                    <!-- サイト設定 (single) - 例: b2状態 -->
                    <li class="tree-item">
                        <div class="tree-item-header" data-model="settings" data-type="single" data-state="published-only">
                            <span class="tree-toggle">▶</span>
                            <span class="tree-icon">⚙️</span>
                            <span class="tree-label">サイト設定</span>
                        </div>
                        <ul class="tree-submenu">
                            <li class="tree-submenu-item" data-action="published">公開中</li>
                        </ul>
                    </li>

                </ul>
            </div>
        </div>
    </aside>

    <!-- メインコンテンツ -->
    <main class="custom-main">
        <!-- パンくずリスト -->
        <div class="breadcrumb">
            <span>コンテンツ</span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current" id="breadcrumb-current">記事</span>
        </div>

        <header class="main-header">
            <h2 id="main-title">記事一覧</h2>
        </header>

        <!-- フィルター -->
        <div class="content-filters">
            <input type="search" placeholder="記事を検索..." class="search-input">
        </div>

        <!-- コレクション用カードリスト -->
        <div class="content-list" id="collection-content">
            <!-- a1: 編集中のみ -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-header-top">
                        <span class="card-content-type">記事</span>
                        <div class="status-tags">
                            <span class="status-tag status-tag-draft">編集中</span>
                        </div>
                    </div>
                    <h3 class="card-title">2024年の技術トレンド予測</h3>
                </div>
                <div class="card-meta">
                    <div class="card-meta-left">
                        <div class="card-action-buttons">
                            <%=link_to edit_admin_area_content_entry_path(1), class: 'btn btn-xs btn-edit' do%><i class="fas fa-edit icon-prefix"></i>編集<%end%>
                            <%=link_to '#', class: 'btn btn-xs btn-preview', target: '_blank' do%><i class="fas fa-check-double icon-prefix"></i>プレビュー<i class="fas fa-external-link-alt icon-suffix"></i><%end%>
                        </div>
                    </div>
                    <span class="card-updated">2024-01-16 10:30</span>
                </div>
            </div>

            <!-- a2: 公開中のみ -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-header-top">
                        <span class="card-content-type">記事</span>
                        <div class="status-tags">
                            <span class="status-tag status-tag-published">公開中</span>
                        </div>
                    </div>
                    <h3 class="card-title">AIと創造性の未来</h3>
                </div>
                <div class="card-meta">
                    <div class="card-meta-left">
                        <div class="card-actions-area">
                            <div class="card-action-group">
                                <%= link_to '#', class: 'btn btn-xs btn-external', target: '_blank' do %><i class="fas fa-globe icon-prefix"></i>公開ページ<i class="fas fa-external-link-alt icon-suffix"></i><% end %>
                                <button class="btn btn-xs btn-edit"><i class="fas fa-edit icon-prefix"></i>新しいバージョンを作成して編集</button>
                            </div>
                        </div>
                    </div>
                    <span class="card-updated">2024-01-15 14:20</span>
                </div>
            </div>

            <!-- a3: 公開中＋編集中 -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-header-top">
                        <span class="card-content-type">記事</span>
                        <div class="status-tags">
                            <span class="status-tag status-tag-published">公開中</span>
                            <span class="status-tag status-tag-draft">編集中</span>
                        </div>
                    </div>
                    <h3 class="card-title">リモートワークのベストプラクティス：効率的な在宅勤務のための完全ガイド</h3>
                </div>
                <div class="card-meta">
                    <div class="card-meta-left">
                        <div class="card-actions-area">
                            <div class="card-action-group">
                                <%= link_to '#', class: 'btn btn-xs btn-external', target: '_blank' do %><i class="fas fa-globe icon-prefix"></i>公開ページ<i class="fas fa-external-link-alt icon-suffix"></i><% end %>
                                <%= link_to edit_admin_area_content_entry_path(6), class: 'btn btn-xs btn-edit' do %><i class="fas fa-edit icon-prefix"></i>編集<% end %>
                                <%= link_to '#', class: 'btn btn-xs btn-preview', target: '_blank' do %><i class="fas fa-check-double icon-prefix"></i>プレビュー<i class="fas fa-external-link-alt icon-suffix"></i><% end %>
                            </div>
                        </div>
                    </div>
                    <span class="card-updated">2024-01-14 16:45</span>
                </div>
            </div>

            <!-- 他のコンテンツタイプの例 -->
            <div class="content-card">
                <div class="card-header">
                    <div class="card-header-top">
                        <span class="card-content-type">商品</span>
                        <div class="status-tags">
                            <span class="status-tag status-tag-published">公開中</span>
                        </div>
                    </div>
                    <h3 class="card-title">プレミアムワイヤレスヘッドフォン XZ-900 - 高音質ノイズキャンセリング機能付き</h3>
                </div>
                <div class="card-meta">
                    <div class="card-meta-left">
                        <div class="card-actions-area">
                            <div class="card-action-group">
                                <%= link_to '#', class: 'btn btn-xs btn-external', target: '_blank' do %><i class="fas fa-globe icon-prefix"></i>公開ページ<i class="fas fa-external-link-alt icon-suffix"></i><% end %>
                                <button class="btn btn-xs btn-edit"><i class="fas fa-edit icon-prefix"></i>新しいバージョンを作成して編集</button>
                            </div>
                        </div>
                    </div>
                    <span class="card-updated">2024-01-13 11:00</span>
                </div>
            </div>
        </div>

        <!-- シングルコンテンツ用表示エリア -->
        <div class="single-content-area hidden" id="single-content">
            <div class="single-content-header">
                <h3 class="single-content-title" id="single-title">会社概要</h3>
                <div id="single-actions">
                    <button class="btn btn-primary">編集</button>
                </div>
            </div>

            <div class="single-content-meta" id="single-meta">
                <span class="single-content-meta-label">ステータス:</span>
                <span class="single-content-meta-value" id="single-status">下書き</span>

                <span class="single-content-meta-label">最終更新:</span>
                <span class="single-content-meta-value" id="single-updated">2024-01-16 14:30</span>

                <span class="single-content-meta-label">作成者:</span>
                <span class="single-content-meta-value" id="single-author">管理者</span>
            </div>

            <div id="single-description">
                <p>ここにコンテンツの詳細情報や編集フォームが表示されます。</p>
            </div>
        </div>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const treeHeaders = document.querySelectorAll('.tree-item-header');
        const breadcrumb = document.getElementById('breadcrumb-current');
        const mainTitle = document.getElementById('main-title');
        const contentTable = document.getElementById('content-table');

        treeHeaders.forEach(header => {
            header.addEventListener('click', function() {
                const toggle = this.querySelector('.tree-toggle');
                const submenu = this.nextElementSibling;

                // サブメニューの展開/折りたたみ
                if (submenu && submenu.classList.contains('tree-submenu')) {
                    toggle.classList.toggle('expanded');
                    submenu.classList.toggle('expanded');
                }

                // アクティブ状態の切り替え
                treeHeaders.forEach(item => item.classList.remove('active'));
                this.classList.add('active');

                // コンテンツの更新
                const model = this.dataset.model;
                const type = this.dataset.type;
                const label = this.querySelector('.tree-label').textContent;

                // data-model がない場合はスキップ
                if (!model) return;

                breadcrumb.textContent = label;

                // singleタイプの場合はタイトルを変更
                if (type === 'single') {
                    mainTitle.textContent = label;
                } else {
                    mainTitle.textContent = label + '一覧';
                }

                // テーブル内容の更新（実際の実装ではAjaxで取得）
                updateContent(model, type);
            });
        });

        // サブメニューアイテムのクリックイベント
        document.querySelectorAll('.tree-submenu-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.stopPropagation();

                const action = this.dataset.action;
                const parentHeader = this.closest('.tree-item').querySelector('.tree-item-header');
                const model = parentHeader.dataset.model;
                const type = parentHeader.dataset.type;

                if (type === 'single' && action) {
                    handleSingleContentAction(model, action);
                } else {
                    console.log('Clicked:', this.textContent);
                }
            });
        });

        function handleSingleContentAction(model, action) {
            const breadcrumb = document.getElementById('breadcrumb-current');
            const mainTitle = document.getElementById('main-title');
            const collectionContent = document.getElementById('collection-content');
            const singleContent = document.getElementById('single-content');
            const contentFilters = document.querySelector('.content-filters');

            // シングルコンテンツエリアを表示
            collectionContent.classList.add('hidden');
            singleContent.classList.remove('hidden');
            contentFilters.style.display = 'none';

            // パンくずとタイトルを更新
            const modelNames = {
                'about': '会社概要',
                'privacy': 'プライバシーポリシー',
                'terms': '利用規約',
                'contact': 'お問い合わせ',
                'settings': 'サイト設定'
            };

            const modelName = modelNames[model] || model;
            breadcrumb.textContent = modelName;

            if (action === 'published') {
                mainTitle.textContent = `${modelName}（公開中）`;
            } else if (action === 'draft') {
                mainTitle.textContent = `${modelName}（下書き）`;
            } else {
                mainTitle.textContent = modelName;
            }

            // シングルコンテンツの詳細を更新
            updateSingleContentByAction(model, action);
        }

        function updateSingleContentByAction(model, action) {
            const title = document.getElementById('single-title');
            const status = document.getElementById('single-status');
            const updated = document.getElementById('single-updated');
            const author = document.getElementById('single-author');
            const actions = document.getElementById('single-actions');

            const modelNames = {
                'about': '会社概要',
                'privacy': 'プライバシーポリシー',
                'terms': '利用規約',
                'contact': 'お問い合わせ',
                'settings': 'サイト設定'
            };

            title.textContent = modelNames[model] || model;

            // モックデータ：編集中下書きの存在状況
            const hasDraft = {
                'about': true,    // 編集中下書きあり
                'privacy': false, // 編集中下書きなし
                'terms': true,    // 編集中下書きあり（b3状態）
                'contact': true,  // 編集中下書きあり
                'settings': false // 編集中下書きなし
            };

            if (action === 'published') {
                status.textContent = '公開中';

                // 編集中下書きがある場合は「編集用コピーを作成」ボタンを非表示
                if (hasDraft[model]) {
                    actions.innerHTML = `
                        <a href="#" class="btn btn-secondary" target="_blank">公開ページ</a>
                    `;
                } else {
                    actions.innerHTML = `
                        <a href="#" class="btn btn-secondary" target="_blank">公開ページ</a>
                        <button class="btn btn-secondary">編集用コピーを作成</button>
                    `;
                }
            } else if (action === 'draft') {
                status.textContent = '下書き';
                actions.innerHTML = `
                    <a href="#" class="btn btn-primary">編集</a>
                    <a href="#" class="btn btn-secondary">プレビュー</a>
                `;
            }

            updated.textContent = '2024-01-16 14:30';
            author.textContent = '管理者';
        }

        function updateSingleContent(model) {
            const title = document.getElementById('single-title');
            const status = document.getElementById('single-status');
            const updated = document.getElementById('single-updated');
            const author = document.getElementById('single-author');
            const actions = document.getElementById('single-actions');

            // モックデータ（実際の実装では、サーバーからデータを取得）
            const singleData = {
                'about': {
                    title: '会社概要',
                    status: '下書き',
                    updated: '2024-01-16 14:30',
                    author: '管理者',
                    state: 'draft-only',
                    hasDraft: true
                },
                'privacy': {
                    title: 'プライバシーポリシー',
                    status: '公開中',
                    updated: '2024-01-10 09:15',
                    author: '法務部',
                    state: 'published-only',
                    hasDraft: false
                },
                'terms': {
                    title: '利用規約',
                    status: '下書き',
                    updated: '2024-01-14 16:20',
                    author: '管理者',
                    state: 'both',
                    hasDraft: true
                }
            };

            const data = singleData[model] || singleData['about'];

            title.textContent = data.title;
            status.textContent = data.status;
            updated.textContent = data.updated;
            author.textContent = data.author;

            // 状態に応じてアクションボタンを変更
            if (data.state === 'published-only') {
                // 編集中下書きがある場合は「編集用コピーを作成」ボタンを非表示
                if (data.hasDraft) {
                    actions.innerHTML = `
                        <a href="#" class="btn btn-secondary" target="_blank">公開ページ</a>
                    `;
                } else {
                    actions.innerHTML = `
                        <a href="#" class="btn btn-secondary" target="_blank">公開ページ</a>
                        <button class="btn btn-secondary">編集用コピーを作成</button>
                    `;
                }
            } else {
                actions.innerHTML = `
                    <a href="#" class="btn btn-primary">編集</a>
                    <a href="#" class="btn btn-secondary">プレビュー</a>
                `;
            }
        }

        function updateContent(model, type) {
            const collectionContent = document.getElementById('collection-content');
            const singleContent = document.getElementById('single-content');
            const contentFilters = document.querySelector('.content-filters');

            if (type === 'single') {
                // シングルコンテンツの場合
                collectionContent.classList.add('hidden');
                singleContent.classList.remove('hidden');
                contentFilters.style.display = 'none';

                // シングルコンテンツの詳細を更新
                updateSingleContent(model);
            } else {
                // コレクションコンテンツの場合
                singleContent.classList.add('hidden');
                collectionContent.classList.remove('hidden');
                contentFilters.style.display = 'flex';

                // コレクションコンテンツの一覧を更新
                updateCollectionContent(model);
            }
        }

        function updateCollectionContent(model) {
            // コレクションコンテンツの一覧更新処理
            console.log('Loading collection content for:', model);
        }
    });
</script>