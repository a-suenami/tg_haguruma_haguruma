<% content_for :title, 'プロフィール設定' %>

<main class="main">
  <header class="main-header">
    <h2>プロフィール設定</h2>
  </header>

  <div class="profile-form">
    <% if @error_message.present? %>
      <div class="alert alert-error">
        <%= @error_message %>
      </div>
    <% end %>

    <%= form_with scope: :profile, url: admin_area_profiles_path, method: :patch, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, 'メールアドレス', class: 'form-label' %>
        <%= f.text_field :email,
          value: @auth0_account&.email,
          required: true,
          type: 'email',
          placeholder: 'admin@example.com',
          class: 'form-input' %>
        <div class="form-hint">ログインに使用するメールアドレス</div>
      </div>

      <div class="form-group">
        <%= f.label :password, 'パスワード', class: 'form-label' %>
        <%= f.password_field :password,
          placeholder: '新しいパスワード（変更する場合のみ）',
          class: 'form-input' %>
        <div class="form-hint">変更しない場合は空欄のまま</div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save icon-prefix"></i>更新</button>
      </div>
    <% end %>
  </div>
</main>
