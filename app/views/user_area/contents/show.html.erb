<% content_for :title do %>
  Content - <%= current_tenant&.name %>
<% end %>

<% published_version = @content_entry.versions.find(&:published?) %>

<div style="margin-bottom: 1rem;">
  <%= link_to "← Back to #{@content_type.display_name}", user_area_contents_path(content_type_id: @content_type.id), style: 'color: var(--primary-color);' %>
</div>

<div class="card">
  <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
    <%= @content_type.display_name %> / Published: <%= published_version&.published_at&.strftime('%Y/%m/%d %H:%M') %>
  </p>

  <% if published_version %>
    <% published_version.fields.includes(:content_type_field, :text, :richtext, :media_asset, :select).each do |field| %>
      <div style="margin-bottom: 1.5rem;">
        <h4 style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 0.5rem;">
          <%= field.content_type_field&.label %>
        </h4>
        <% case field.field_type %>
        <% when 'text' %>
          <p><%= field.text&.value %></p>
        <% when 'richtext' %>
          <div class="richtext-content" style="line-height: 1.8;">
            <%= raw lexical_to_html(field.richtext&.value) %>
          </div>
        <% when 'media_asset' %>
          <% if field.media_asset&.media_type == 'image' %>
            <img src="<%= field.media_asset&.s3_object_path %>" style="max-width: 100%; height: auto;" alt="">
          <% else %>
            <p>Media: <%= field.media_asset&.media_type %></p>
          <% end %>
        <% when 'select_field' %>
          <%
            selected_ids = field.select&.selected_option_ids || []
            options = field.content_type_field&.select&.options&.where(id: selected_ids) || []
          %>
          <% if options.any? %>
            <ul style="margin: 0; padding-left: 1.5rem;">
              <% options.each do |option| %>
                <li><%= option.display_name %></li>
              <% end %>
            </ul>
          <% else %>
            <p style="color: var(--text-muted);">未選択</p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p style="color: var(--text-muted);">No published version available.</p>
  <% end %>
</div>
