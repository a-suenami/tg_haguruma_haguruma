<% content_for :title do %>
  <%= login_label %> - <%= current_tenant&.name %>
<% end %>

<div cog-landing>
  <%= render 'user_area/alpha/shared/page_header' %>

  <main class="main" style="justify-content: center;">
    <section cog-landing-introduction style="background: transparent; box-shadow: none;">
      <div class="introduction-content">
        <% if flash[:alert] %>
          <p class="login-alert"><%= flash[:alert] %></p>
        <% end %>

        <%= form_with url: user_area_login_path, method: :post, data: { turbo: false } do |f| %>
          <button type="submit" class="primary-action">
            <span class="action-text"><%= login_label %></span>
            <span class="action-icon"><%= icon_svg('right-arrow') %></span>
          </button>
        <% end %>

        <% if custom_variables.enabled?('signup_flow') %>
          <a href="<%= user_area_auth_start_path(signup: true) %>" cog-link variant-underline>
            新規登録はこちら
          </a>
        <% end %>
      </div>
    </section>
  </main>

  <%= render 'user_area/alpha/shared/page_footer' %>
</div>
