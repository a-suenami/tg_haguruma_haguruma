<div class="layout-list-page">
  <% content_for :title do %>
    <%= feature_label(:news) %> - <%= current_tenant&.name || 'Fan Club' %>
  <% end %>

  <%= render 'user_area/alpha/shared/page_header' %>

  <main class="main">
    <section cog-list-fragment>
      <div cog-list-fragment-title>
        <div cog-feature-title-image feature="news">
          <div class="title-image"><%= feature_label(:news) %></div>
        </div>
      </div>

      <% if categories.present? %>
        <div cog-list-fragment-actions>
          <%= render 'user_area/alpha/shared/content/category_tabs',
                     categories: categories,
                     current_category: current_category,
                     path_helper: ->(cat) { user_area_news_index_path(category: cat) } %>
        </div>
      <% end %>

      <%= turbo_frame_tag "content-list" do %>
        <div cog-list-fragment-content>
          <div cog-news-list>
            <% if @entries.empty? %>
              <div class="empty-state">
                <% if current_category.present? %>
                  <% category_display_name = categories.find { |c| c.unique_name == current_category }&.display_name %>
                  <p><%= category_display_name %>の<%= feature_label(:news) %>はありません</p>
                <% else %>
                  <p><%= feature_label(:news) %>がありません</p>
                <% end %>
              </div>
            <% else %>
              <div class="list">
                <% @entries.each_with_index do |entry, i| %>
                  <% version = published_version(entry) %>
                  <% next if version.nil? %>
                  <a href="<%= user_area_news_path(entry) %>" cog-news-item data-turbo-frame="_top">
                  <div class="header">
                    <div class="date">
                      <span cog-date-label><%= format_content_date(entry.display_publication_date) %></span>
                    </div>
                    <% category_field = field_by_identifier(version, 'category') %>
                    <% category_option = selected_option(category_field) %>
                    <div class="category">
                      <% if version.visibility == 'authenticated' %>
                        <span cog-category-label color-primary>会員限定</span>
                      <% end %>
                      <% if category_option.present? %>
                        <span cog-category-label color-secondary><%= category_option.display_name %></span>
                      <% end %>
                    </div>
                  </div>
                    <div class="title"><%= render_text_field(field_by_identifier(version, 'title')) %></div>
                  </a>
                  <% unless i == @entries.length - 1 %>
                    <div class="divider"></div>
                  <% end %>
                <% end %>
              </div>

            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </main>

  <%= render 'user_area/alpha/shared/page_footer' %>
</div>
