<% content_for :title do %>
  TICKET - <%= current_tenant&.name || 'Fan Club' %>
<% end %>

<%= render 'user_area/alpha/shared/page_header' %>

<main class="main">
  <section cog-list-fragment>
    <div cog-list-fragment-title>
      <div cog-feature-title-image feature="ticket">
        <div class="title-image">TICKET</div>
      </div>
    </div>

    <div cog-list-fragment-actions>
      <nav cog-tabs-bar>
        <div cog-tabs>
          <button cog-tab class="active">
            <div class="text">すべて</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">ライブ</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">イベント</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">先行販売</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">一般販売</div>
            <div class="current-line"></div>
          </button>
        </div>
      </nav>
    </div>

    <div cog-list-fragment-content>
      <div cog-blog-list>
        <div class="list">
          <% 10.times do |i| %>
            <a href="<%= user_area_ticket_path(i + 1) %>" cog-blog-item>
              <div class="thumbnail">
                <img draggable="false" src="https://placehold.co/600x400/e8e8e8/999999?text=Ticket+<%= i + 1 %>" alt="Ticket Thumbnail">
                <div class="label">
                  <span cog-category-label>ライブ</span>
                </div>
              </div>
              <div class="title">サンプルチケット <%= i + 1 %> - 2025年春ツアー</div>
            </a>
          <% end %>
        </div>

        <div class="pagination-button-container">
          <button cog-button primary outlined>VIEW MORE</button>
        </div>
      </div>
    </div>
  </section>
</main>

<%= render 'user_area/alpha/shared/page_footer' %>
