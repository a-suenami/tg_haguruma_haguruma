<div class="layout-list-page">
  <% content_for :title do %>
    <%= feature_label(:ticket) %> - <%= current_tenant&.name || 'Fan Club' %>
  <% end %>

  <%= render 'user_area/alpha/shared/page_header' %>

  <main class="main">
    <section cog-list-fragment>
      <div cog-list-fragment-title>
        <div cog-feature-title-image feature="ticket">
          <div class="title-image"><%= feature_label(:ticket) %></div>
        </div>
      </div>

      <% if categories.present? %>
        <div cog-list-fragment-actions>
          <%= render 'user_area/alpha/shared/content/category_tabs',
                     categories: categories,
                     current_category: current_category,
                     path_helper: ->(cat) { user_area_tickets_path(category: cat) } %>
        </div>
      <% end %>

      <%= turbo_frame_tag "content-list" do %>
        <div cog-list-fragment-content>
          <div cog-blog-list>
            <% if @entries.empty? %>
              <div class="empty-state">
                <% if current_category.present? %>
                  <% category_display_name = categories.find { |c| c.unique_name == current_category }&.display_name %>
                  <p><%= category_display_name %>の<%= feature_label(:ticket) %>はありません</p>
                <% else %>
                  <p><%= feature_label(:ticket) %>がありません</p>
                <% end %>
              </div>
            <% else %>
              <div class="list">
                <% @entries.each do |entry| %>
                  <% version = published_version(entry) %>
                  <% next if version.nil? %>
                  <a href="<%= user_area_ticket_path(entry) %>" cog-blog-item data-turbo-frame="_top">
                    <div class="thumbnail">
                      <% if version.visibility == 'authenticated' %>
                        <span class="member-only">会員限定</span>
                      <% end %>
                      <% thumbnail_url = media_asset_url(field_by_identifier(version, 'thumbnail')) %>
                      <img draggable="false" src="<%= thumbnail_url || '/images/yokikotokiku/noimage.svg' %>" alt="Ticket Thumbnail">
                      <% category_field = field_by_identifier(version, 'category') %>
                        <% category_option = selected_option(category_field) %>
                        <% if category_option.present? %>
                          <span class="label"><%= category_option.display_name %></span>
                        <% end %>
                    </div>
                    <div class="texts">
                      <div class="title"><%= render_text_field(field_by_identifier(version, 'title')) %></div>
                      <div class="date">
                        <span cog-date-label><%= format_content_date(version.published_at) %></span>
                      </div>
                    </div>
                  </a>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </main>

  <%= render 'user_area/alpha/shared/page_footer' %>
</div>
