<%
=begin
%>

<%
  # Generate calendar data for the given month
  year ||= Date.current.year
  month ||= Date.current.month
  first_day = Date.new(year, month, 1)
  last_day = first_day.end_of_month
  start_date = first_day.beginning_of_week(:sunday)
  end_date = last_day.end_of_week(:sunday)
  weeks = (start_date..end_date).each_slice(7).to_a
  today = Date.current
  weekdays = %w[日 月 火 水 木 金 土]
%>
<div class="calendar-container">
  <div class="calendar-header">
    <button type="button" class="calendar-nav prev" disabled>
      <span class="nav-icon">&lt;</span>
    </button>
    <span class="calendar-period"><%= year %>年<%= month %>月</span>
    <button type="button" class="calendar-nav next" disabled>
      <span class="nav-icon">&gt;</span>
    </button>
  </div>

  <table class="calendar-table">
    <thead>
      <tr>
        <% weekdays.each do |day| %>
          <th><%= day %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% weeks.each do |week| %>
        <tr>
          <% week.each do |date| %>
            <%
              classes = ['calendar-date']
              classes << 'other-month' if date.month != month
              classes << 'today' if date == today
            %>
            <td class="<%= classes.join(' ') %>">
              <span class="date-number"><%= date.day %></span>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%
=end
%>
