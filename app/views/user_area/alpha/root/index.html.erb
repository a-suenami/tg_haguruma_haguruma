<% content_for :title do %>
  <%= current_tenant&.name || 'Fan Club' %>
<% end %>

<div cog-landing>
<%= render 'user_area/alpha/shared/page_header' %>

<main class="main">
  <section cog-landing-hero-image-section>
    <div cog-landing-hero-image>
      <% if @kv_pc_image_url || @kv_sp_image_url %>
        <picture>
          <% if @kv_sp_image_url %>
            <%# FIXME(#14): width/heightを動的に設定 %>
            <source media="(max-width: 767px)" srcset="<%= @kv_sp_image_url %>" width=390 height=420>
          <% end %>
          <img src="<%= @kv_pc_image_url || @kv_sp_image_url %>" alt="<%= current_tenant&.name || '' %>" width=1440 height=600>
        </picture>
      <% else %>
        <img src="https://placehold.co/1920x1080/333333/666666?text=Hero+Image" alt="Hero Image">
      <% end %>
    </div>
  </section>

  <div class="main-content">
    <% unless user_signed_in? %>
      <section cog-landing-section>
        <div cog-landing-section-content>
          <div cog-landing-section-actions>
            <a href="<%= user_area_auth_start_path %>" cog-button filled class="action-button">
              <span class="action-button-text"><%= login_label %></span>
              <span class="action-button-icon"><%= icon_svg('sign-in-indicator') %></span>
            </a>
            <a href="<%= user_area_auth_start_path(signup: true) %>" cog-button outlined class="action-button">
              <span class="action-button-text"><%= signup_label %></span>
              <span class="action-button-icon"><%= icon_svg('sign-up-indicator') %></span>
            </a>
          </div>
        </div>
        <% if @banners.present? %>
          <div cog-landing-section-content>
            <div class="swiper banner-swiper" data-controller="swiper">
              <div class="swiper-wrapper">
                <% @banners.each do |entry| %>
                  <% version = published_version(entry) %>
                  <% next if version.nil? %>
                  <% image_url = media_asset_url(field_by_identifier(version, 'image')) %>
                  <% link_url = render_text_field(field_by_identifier(version, 'link_url')) %>
                  <% alt_text = render_text_field(field_by_identifier(version, 'alt_text')) %>
                  <div class="swiper-slide">
                    <% if link_url.present? %>
                      <a href="<%= link_url %>" cog-landing-banner>
                        <%# FIXME(#14): width/heightを動的に設定 %>
                        <img src="<%= image_url %>" alt="<%= alt_text %>" width=300 height=90>
                      </a>
                    <% else %>
                      <div cog-landing-banner>
                        <img src="<%= image_url %>" alt="<%= alt_text %>"  width=300 height=90>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="swiper-pagination"></div>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if @news_entries.present? %>
      <section cog-landing-section>
        <div cog-landing-section-title>
          <div cog-feature-title-image feature="news">
            <div class="title-image"><%= feature_label(:news) %></div>
          </div>
        </div>
        <div cog-landing-section-content>
          <div cog-news-list overview>
            <div class="list">
              <% @news_entries.each_with_index do |entry, i| %>
                <% version = published_version(entry) %>
                <% next if version.nil? %>
                <a href="<%= user_area_news_path(entry) %>" cog-news-item>
                  <div class="category">
                    <% category_field = field_by_identifier(version, 'category') %>
                    <% category_option = selected_option(category_field) %>
                    <span cog-category-label><%= category_option&.display_name || '-' %></span>
                  </div>
                  <div class="date">
                    <span cog-date-label><%= format_content_date(version.published_at) %></span>
                  </div>
                  <div class="title"><%= render_text_field(field_by_identifier(version, 'title')) %></div>
                </a>
                <% unless i == @news_entries.length - 1 %>
                  <div class="divider"></div>
                <% end %>
              <% end %>
            </div>
            <div class="overview-page-indicator">
              <a href="<%= user_area_news_index_path %>" cog-button primary outlined>VIEW ALL</a>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <% if @blog_entries.present? %>
      <%= turbo_frame_tag "blog-section" do %>
        <section cog-landing-section>
          <div cog-landing-section-title>
            <div cog-feature-title-image feature="blog">
              <div class="title-image"><%= feature_label(:blog) %></div>
            </div>
          </div>
          <div cog-landing-section-actions>
            <%= render 'user_area/alpha/shared/content/category_tabs',
                      categories: @blog_categories,
                      current_category: current_blog_category,
                      path_helper: ->(cat) { user_area_root_path(blog_category: cat) } %>
          </div>
          <div cog-landing-section-content>
            <% if @blog_entries.present? %>
              <div cog-blog-list>
                <div class="list">
                  <% @blog_entries.each do |entry| %>
                    <% version = published_version(entry) %>
                    <% next if version.nil? %>
                    <a href="<%= user_area_blog_path(entry) %>" cog-blog-item data-turbo-frame="_top">
                      <div class="thumbnail">
                        <% thumbnail_url = media_asset_url(field_by_identifier(version, 'thumbnail')) %>
                        <img draggable="false" src="<%= thumbnail_url || '/images/yokikotokiku/noimage.svg' %>" alt="Blog Thumbnail">
                        <div class="label">
                          <% category_field = field_by_identifier(version, 'category') %>
                          <% category_option = selected_option(category_field) %>
                          <span cog-category-label><%= category_option&.display_name || '-' %></span>
                        </div>
                      </div>
                      <div class="title"><%= render_text_field(field_by_identifier(version, 'title')) %></div>
                      <div class="date">
                        <span cog-date-label><%= format_content_date(version.published_at) %></span>
                      </div>
                    </a>
                  <% end %>
                </div>
                <% if @blog_entries.length >= 6 %>
                  <div class="overview-page-indicator">
                    <a href="<%= user_area_blog_index_path(category: current_blog_category) %>" cog-button primary outlined data-turbo-frame="_top">VIEW ALL</a>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    <% end %>

  </div>
</main>

<%= render 'user_area/alpha/shared/page_footer' %>
</div>
