<% version = published_version(@entry) %>
<% title_text = render_text_field(field_by_identifier(version, 'title')) %>

<% content_for :title do %>
  <%= title_text.presence || feature_label(:blog) %> - <%= current_tenant&.name || 'Fan Club' %>
<% end %>

<%= render 'user_area/alpha/shared/page_header' %>

<main class="main">
  <div class="inner">
    <article cog-detail-fragment>
      <header cog-detail-fragment-header>
        <div cog-detail-fragment-toolbar>
          <% category_field = field_by_identifier(version, 'category') %>
          <% category_option = selected_option(category_field) %>
          <span cog-category-label><%= category_option&.display_name || '-' %></span>
          <span cog-date-label><%= format_content_date(version&.published_at) %></span>
        </div>
        <div cog-detail-fragment-toolbar>
          <h1 cog-detail-fragment-title><%= title_text %></h1>
        </div>
        <% thumbnail_url = media_asset_url(field_by_identifier(version, 'thumbnail')) %>
        <% if thumbnail_url.present? %>
        <div cog-detail-fragment-toolbar>
          <img class="thumbnail" src="<%= thumbnail_url %>" alt="<%= title_text %>">
        </div>
        <% end %>
      </header>

      <div cog-detail-fragment-content>
        <% if content_authorized? %>
          <div cog-rich-content-viewer>
            <%= raw render_richtext_field(field_by_identifier(version, 'body')) %>
          </div>
        <% else %>
          <div class="content-masked">
            <div class="masked-overlay">
              <p>このコンテンツを閲覧するには権限が必要です</p>
            </div>
            <div cog-rich-content-viewer class="blurred">
              <%= raw render_richtext_field(field_by_identifier(version, 'body')) %>
            </div>
          </div>
        <% end %>
      </div>

      <footer cog-detail-fragment-actions>
        <a href="<%= user_area_blog_index_path %>" cog-button outlined class="action-button">
          一覧に戻る
        </a>
      </footer>
    </article>
  </div>
</main>

<%= render 'user_area/alpha/shared/page_footer' %>
