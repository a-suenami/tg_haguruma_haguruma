<% content_for :title do %>
  BLOG - <%= current_tenant&.name || 'Fan Club' %>
<% end %>

<%= render 'user_area/alpha/shared/page_header' %>

<main class="main">
  <section cog-list-fragment>
    <div cog-list-fragment-title>
      <div cog-feature-title-image feature="blog">
        <div class="title-image"><%= feature_title_svg('blog') %></div>
      </div>
    </div>

    <div cog-list-fragment-actions>
      <nav cog-tabs-bar>
        <div cog-tabs>
          <button cog-tab class="active">
            <div class="text">すべて</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">ファッション</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">音楽</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">グルメ</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">旅行</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">アート</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">ライフスタイル</div>
            <div class="current-line"></div>
          </button>
          <button cog-tab>
            <div class="text">スペシャル</div>
            <div class="current-line"></div>
          </button>
        </div>
      </nav>
    </div>

    <div cog-list-fragment-content>
      <div cog-blog-list>
        <div class="list">
          <% 10.times do |i| %>
            <a href="<%= user_area_blog_path(i + 1) %>" cog-blog-item>
              <div class="thumbnail">
                <img draggable="false" src="https://placehold.co/600x400/e8e8e8/999999?text=Blog+<%= i + 1 %>" alt="Blog Thumbnail">
                <div class="label">
                  <span cog-category-label>ファッション</span>
                </div>
              </div>
              <div class="title">サンプルブログタイトル <%= i + 1 %></div>
            </a>
          <% end %>
        </div>

        <div class="pagination-button-container">
          <button cog-button primary outlined>VIEW MORE</button>
        </div>
      </div>
    </div>
  </section>
</main>

<%= render 'user_area/alpha/shared/page_footer' %>
