<footer cog-footer>
  <nav cog-footer-menu>
    <a cog-footer-menu-item href="<%= user_area_root_path %>">TOP</a>
    <% if feature_enabled?(:biography) %>
      <a cog-footer-menu-item href="<%= user_area_biography_path %>"><%= feature_label(:biography, :menu_label) %></a>
    <% end %>
    <% if feature_enabled?(:news) %>
      <a cog-footer-menu-item href="<%= user_area_news_index_path %>"><%= feature_label(:news, :menu_label) %></a>
    <% end %>
    <% if feature_enabled?(:blog) %>
      <a cog-footer-menu-item href="<%= user_area_blog_index_path %>"><%= feature_label(:blog, :menu_label) %></a>
    <% end %>
    <% if feature_enabled?(:ticket) %>
      <a cog-footer-menu-item href="<%= user_area_tickets_path %>"><%= feature_label(:ticket, :menu_label) %></a>
    <% end %>
    <% if feature_enabled?(:schedule) %>
      <a cog-footer-menu-item href="<%= user_area_schedules_path %>"><%= feature_label(:schedule, :menu_label) %></a>
    <% end %>
  </nav>

  <div cog-legal-links>
    <a cog-legal-link href="#">利用規約・チケット規約</a>
    <a cog-legal-link href="#">個人情報の取り扱いについて</a>
    <a cog-legal-link href="#">プライバシーポリシー</a>
    <a cog-legal-link href="#">特定商取引法に基づく表記</a>
    <a cog-legal-link href="#">FAQ / お問い合わせ</a>
  </div>

  <div cog-sns-items>
    <a cog-sns-item href="#" target="_blank" rel="noopener"><%= icon_svg('sns-x') %></a>
    <a cog-sns-item href="#" target="_blank" rel="noopener"><%= icon_svg('sns-instagram') %></a>
  </div>

  <div cog-copyright>
    &copy; <%= Time.current.year %> <%= current_tenant&.name || 'Fan Club' %>
  </div>
</footer>
