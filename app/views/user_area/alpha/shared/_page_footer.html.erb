<%# Footer uses 'features' (enabled_features) same as PC header %>
<footer cog-footer>
  <nav cog-footer-menu>
    <a cog-footer-menu-item href="<%= user_area_root_path %>">TOP</a>
    <% enabled_features.each do |feature| %>
      <a cog-footer-menu-item href="<%= feature_path(feature['key']) %>"><%= feature['label'] %></a>
    <% end %>
  </nav>

  <div cog-legal-links>
    <a cog-legal-link href="#">利用規約・チケット規約</a>
    <a cog-legal-link href="#">個人情報の取り扱いについて</a>
    <a cog-legal-link href="#">プライバシーポリシー</a>
    <a cog-legal-link href="#">特定商取引法に基づく表記</a>
    <a cog-legal-link href="#">FAQ / お問い合わせ</a>
  </div>

  <div cog-sns-items>
    <a cog-sns-item href="#" target="_blank" rel="noopener"><%= icon_svg('sns-x') %></a>
    <a cog-sns-item href="#" target="_blank" rel="noopener"><%= icon_svg('sns-instagram') %></a>
  </div>

  <div cog-copyright>
    &copy; <%= Time.current.year %> <%= current_tenant&.name || 'Fan Club' %>
  </div>
</footer>
