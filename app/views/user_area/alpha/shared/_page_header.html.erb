<header cog-header>
  <a href="<%= user_area_root_path %>" cog-header-logo-button>
    <div cog-logo>
      <img src="<%= current_theme.logo_url %>" alt="<%= current_tenant&.name || '' %>">
    </div>
  </a>

  <div class="menu-container browser">
    <nav cog-header-menu>
      <% if feature_enabled?(:news) %>
        <a href="<%= user_area_news_index_path %>" cog-header-menu-item><%= feature_label(:news, :menu_label) %></a>
      <% end %>
      <% if feature_enabled?(:ticket) %>
        <a href="<%= user_area_tickets_path %>" cog-header-menu-item><%= feature_label(:ticket, :menu_label) %></a>
      <% end %>
      <% if feature_enabled?(:blog) %>
        <a href="<%= user_area_blog_index_path %>" cog-header-menu-item><%= feature_label(:blog, :menu_label) %></a>
      <% end %>
      <% if feature_enabled?(:schedule) %>
        <a href="<%= user_area_schedules_path %>" cog-header-menu-item><%= feature_label(:schedule, :menu_label) %></a>
      <% end %>
      <% if feature_enabled?(:biography) %>
        <a href="<%= user_area_biography_path %>" cog-header-menu-item><%= feature_label(:biography, :menu_label) %></a>
      <% end %>
      <div class="auth-action-buttons">
        <% if user_signed_in? %>
          <a href="#" cog-header-menu-item class="auth-action-button">
            <span class="auth-icon"><%= icon_svg('user-circle') %></span>
            <span>マイページ</span>
          </a>
        <% else %>
          <a href="<%= user_area_auth_start_path %>" cog-header-menu-item class="auth-action-button">
            <span class="auth-icon"><%= icon_svg('sign-in-indicator') %></span>
            <span><%= login_label %></span>
          </a>
          <a href="<%= user_area_auth_start_path %>" cog-header-menu-item class="auth-action-button">
            <span class="auth-icon"><%= icon_svg('sign-up-indicator') %></span>
            <span><%= signup_label %></span>
          </a>
        <% end %>
      </div>
    </nav>
  </div>

  <div class="menu-container mobile">
    <button type="button" cog-header-menu-button id="mobile-menu-button">
      <span cog-icon-mobile-header-menu></span>
    </button>

    <div cog-header-menu-overlay id="mobile-menu-overlay" class="hidden">
      <div cog-header-menu-overlay-head>
        <div cog-header-menu-overlay-actions>
          <% if user_signed_in? %>
            <a href="#" cog-button outlined class="overlay-action-button in-vertical">
              <span class="mypage-text">マイページ</span>
              <span class="overlay-icon"><%= icon_svg('user-circle-bold') %></span>
            </a>
          <% else %>
            <a href="<%= user_area_auth_start_path %>" cog-button filled class="overlay-action-button">
              <span><%= login_label %></span>
              <span class="overlay-icon"><%= icon_svg('sign-in-indicator') %></span>
            </a>
            <a href="<%= user_area_auth_start_path %>" cog-button outlined class="overlay-action-button">
              <span><%= signup_label %></span>
              <span class="overlay-icon"><%= icon_svg('sign-up-indicator') %></span>
            </a>
          <% end %>
        </div>
      </div>

      <div cog-header-menu-overlay-content>
        <nav cog-menu-items>
          <a cog-menu-item href="<%= user_area_root_path %>">TOP</a>
          <% if feature_enabled?(:news) %>
            <a cog-menu-item href="<%= user_area_news_index_path %>"><%= feature_label(:news, :menu_label) %></a>
          <% end %>
          <% if feature_enabled?(:ticket) %>
            <a cog-menu-item href="<%= user_area_tickets_path %>"><%= feature_label(:ticket, :menu_label) %></a>
          <% end %>
          <% if feature_enabled?(:blog) %>
            <a cog-menu-item href="<%= user_area_blog_index_path %>"><%= feature_label(:blog, :menu_label) %></a>
          <% end %>
          <% if feature_enabled?(:schedule) %>
            <a cog-menu-item href="<%= user_area_schedules_path %>"><%= feature_label(:schedule, :menu_label) %></a>
          <% end %>
          <% if feature_enabled?(:biography) %>
            <a cog-menu-item href="<%= user_area_biography_path %>"><%= feature_label(:biography, :menu_label) %></a>
          <% end %>
          <% if user_signed_in? %>
            <a cog-menu-item href="#">MYPAGE</a>
          <% end %>
        </nav>

        <div cog-sns-items>
          <a cog-sns-item type="x" href="#" target="_blank" rel="noopener"></a>
          <a cog-sns-item type="instagram" href="#" target="_blank" rel="noopener"></a>
          <a cog-sns-item type="youtube" href="#" target="_blank" rel="noopener"></a>
        </div>
      </div>

      <div cog-header-menu-overlay-footer>
        <div cog-header-menu-banners>
          <a cog-header-menu-banner href="#">
            <img src="https://placehold.co/400x200/e8e8e8/999999?text=Banner+1" alt="Banner 1">
          </a>
          <a cog-header-menu-banner href="#">
            <img src="https://placehold.co/400x200/e8e8e8/999999?text=Banner+2" alt="Banner 2">
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
