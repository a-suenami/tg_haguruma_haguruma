<header cog-header>
  <a href="<%= user_area_root_path %>" cog-header-logo-button>
    <div cog-logo>
      <%# FIXME(#14): width/heightを動的に設定 %>
      <img src="<%= current_theme.logo_url %>" alt="<%= current_tenant&.name || '' %>" width=104 height=53>
    </div>
  </a>

  <%# PC header uses 'features' (enabled_features) %>
  <div class="menu-container browser">
    <nav cog-header-menu>
      <a href="<%= user_area_root_path %>" cog-header-menu-item>TOP</a>
      <% enabled_features.each do |feature| %>
        <a href="<%= feature_path(feature['key']) %>" cog-header-menu-item><%= feature['label'] %></a>
      <% end %>
      <div class="auth-action-buttons">
        <% if user_signed_in? %>
          <a href="#" cog-header-menu-item class="auth-action-button">
            <span class="auth-icon"><%= icon_svg('user-circle') %></span>
            <span>マイページ</span>
          </a>
          <%= form_with url: user_area_logout_path, method: :delete, data: { turbo: false }, class: 'logout-form-inline' do %>
            <button type="submit" cog-header-menu-item class="auth-action-button logout-button">
              <span>ログアウト</span>
            </button>
          <% end %>
        <% else %>
          <a href="<%= user_area_auth_start_path %>" cog-header-menu-item class="auth-action-button">
            <span class="auth-icon"><%= icon_svg('sign-in-indicator') %></span>
            <span><%= login_label %></span>
          </a>
          <a href="<%= user_area_auth_start_path %>" cog-header-menu-item class="auth-action-button">
            <span class="auth-icon"><%= icon_svg('sign-up-indicator') %></span>
            <span><%= signup_label %></span>
          </a>
        <% end %>
      </div>
    </nav>
  </div>

  <%# SP/mobile menu uses 'menu_items' (ordered_menu_items) %>
  <div class="menu-container mobile" data-controller="mobile-menu">
    <button type="button" cog-header-menu-button data-action="click->mobile-menu#toggle">
      <span class="icon" data-mobile-menu-target="menuIcon"><%= icon_svg('hamburger-menu') %></span>
      <span class="icon" data-mobile-menu-target="closeIcon" style="display: none;"><%= icon_svg('peke') %></span>
      <span class="text" data-mobile-menu-target="text">MENU</span>
    </button>

    <div cog-header-menu-overlay data-mobile-menu-target="overlay">
      <div class="inner">
        <div cog-header-menu-overlay-head>
          <div cog-header-menu-overlay-actions>
            <% if user_signed_in? %>
              <a href="#" cog-button outlined class="overlay-action-button in-vertical">
                <span class="mypage-text">マイページ</span>
                <span class="overlay-icon"><%= icon_svg('user-circle-bold') %></span>
              </a>
            <% else %>
              <a href="<%= user_area_auth_start_path %>" cog-button filled class="overlay-action-button">
                <span><%= login_label %></span>
                <span class="overlay-icon"><%= icon_svg('sign-in-indicator') %></span>
              </a>
              <a href="<%= user_area_auth_start_path %>" cog-button outlined class="overlay-action-button">
                <span><%= signup_label %></span>
                <span class="overlay-icon"><%= icon_svg('sign-up-indicator') %></span>
              </a>
            <% end %>
          </div>
        </div>

        <div cog-header-menu-overlay-content>
          <nav cog-menu-items>
            <a cog-menu-item href="<%= user_area_root_path %>">TOP</a>
            <% ordered_menu_items.each do |item| %>
              <% url = menu_item_url(item) %>
              <% is_logout = item['key'] == 'logout' %>
              <%# Skip logout if user not signed in %>
              <% next if is_logout && !user_signed_in? %>
              <% if is_logout %>
                <%= form_with url: user_area_logout_path, method: :delete, data: { turbo: false }, class: 'logout-form-inline' do %>
                  <button type="submit" cog-menu-item><%= item['label'] %></button>
                <% end %>
              <% elsif external_url?(url) %>
                <a cog-menu-item href="<%= url %>" target="_blank" rel="noopener"><%= item['label'] %></a>
              <% else %>
                <a cog-menu-item href="<%= url %>"><%= item['label'] %></a>
              <% end %>
            <% end %>
            <% if user_signed_in? %>
              <a cog-menu-item href="#">MYPAGE</a>
            <% end %>
          </nav>

          <div cog-sns-items>
            <a cog-sns-item href="#" target="_blank" rel="noopener"><%= icon_svg('sns-x') %></a>
            <a cog-sns-item href="#" target="_blank" rel="noopener"><%= icon_svg('sns-instagram') %></a>
          </div>
        </div>

        <% if @banners.present? %>
          <div cog-header-menu-overlay-footer>
            <div cog-header-menu-banners>
              <% @banners.each do |entry| %>
                <% version = published_version(entry) %>
                <% next if version.nil? %>
                <% image_url = media_asset_url(field_by_identifier(version, 'image')) %>
                <% link_url = render_text_field(field_by_identifier(version, 'link_url')) %>
                <% alt_text = render_text_field(field_by_identifier(version, 'alt_text')) %>
                <% if link_url.present? %>
                  <a cog-header-menu-banner href="<%= link_url %>">
                    <img src="<%= image_url %>" alt="<%= alt_text %>">
                  </a>
                <% else %>
                  <div cog-header-menu-banner>
                    <img src="<%= image_url %>" alt="<%= alt_text %>">
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>
