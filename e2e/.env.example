# E2E Test Environment Variables

# Base URL for testing
BASE_URL=http://localhost:3000

# Auth bypass mode (set to 'true' for CI environment)
AUTH_BYPASS=true

# Test tenant ID (required for admin area tests)
# Use 'sample' which is created by db/seeds
TEST_TENANT_ID=sample

# Real authentication credentials (for staging/production tests)
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=your-test-password

# Staging environment URL
# STAGING_URL=https://staging.example.com

# Production environment URL
# PRODUCTION_URL=https://example.com
