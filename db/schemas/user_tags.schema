create_table :user_tags, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.citext :tenant_id, null: false
  t.uuid :user_id, null: false
  t.uuid :content_authorization_tag_id, null: false

  t.timestamps null: false
end

add_index :user_tags, [:tenant_id, :id], unique: true
add_index :user_tags, [:tenant_id, :user_id, :content_authorization_tag_id], unique: true, name: 'index_user_tags_unique'
add_index :user_tags, [:content_authorization_tag_id], name: 'index_user_tags_on_tag'

add_foreign_key :user_tags, :tenants, column: :tenant_id, primary_key: :id
add_foreign_key :user_tags, :users, column: [:tenant_id, :user_id], primary_key: [:tenant_id, :id], name: 'fk_user_tags_users'
add_foreign_key :user_tags, :content_authorization_tags, column: :content_authorization_tag_id
