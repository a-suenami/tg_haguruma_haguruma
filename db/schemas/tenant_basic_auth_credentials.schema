# frozen_string_literal: true

create_table :tenant_basic_auth_credentials, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.uuid :tenant_basic_auth_id, null: false
  t.string :username, null: false
  t.string :password_digest, null: false
  t.string :description, null: false, default: ''
  t.timestamps null: false
end

add_index :tenant_basic_auth_credentials, [:tenant_basic_auth_id]
add_index :tenant_basic_auth_credentials, [:tenant_basic_auth_id, :username], unique: true

add_foreign_key :tenant_basic_auth_credentials, :tenant_basic_auths, column: :tenant_basic_auth_id
