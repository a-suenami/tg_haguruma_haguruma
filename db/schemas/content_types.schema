create_table :content_types, force: :cascade, id: :uuid do |t|
  t.citext :tenant_id, null: false
  t.boolean :is_collection, null: false, default: true
  t.text :display_name, null: false
  t.text :api_identifier, null: false
  t.text :description

  t.timestamps null: false
end

add_index :content_types, [:id, :tenant_id], unique: true
add_index :content_types, [:tenant_id, :id], unique: true
add_index :content_types, [:tenant_id, :api_identifier], unique: true

add_foreign_key :content_types, :tenants, column: :tenant_id, primary_key: :id
