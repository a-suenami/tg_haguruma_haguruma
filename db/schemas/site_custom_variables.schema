create_table :site_custom_variables, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.string :tenant_id, null: false
  t.string :unique_name, null: false
  t.integer :variable_type, limit: 1, null: false, comment: '1: boolean, 2: datetime, 3: text'
  t.text :description, null: false, default: ''

  t.boolean :boolean_value
  t.datetime :datetime_value
  t.text :text_value

  t.datetime :archived_at

  t.timestamps null: false
end

add_index :site_custom_variables, [:tenant_id, :unique_name], unique: true, where: 'archived_at IS NULL', name: 'idx_site_custom_variables_unique_name'
add_index :site_custom_variables, [:tenant_id, :archived_at], name: 'idx_site_custom_variables_tenant_archived'

add_foreign_key :site_custom_variables, :tenants, column: :tenant_id, primary_key: :id

add_check_constraint :site_custom_variables, 'variable_type IN (1, 2, 3)', name: 'chk_site_custom_variables_variable_type'
add_check_constraint :site_custom_variables, 'variable_type != 1 OR (boolean_value IS NOT NULL AND datetime_value IS NULL AND text_value IS NULL)', name: 'chk_site_custom_variables_boolean_consistency'
add_check_constraint :site_custom_variables, 'variable_type != 2 OR (datetime_value IS NOT NULL AND boolean_value IS NULL AND text_value IS NULL)', name: 'chk_site_custom_variables_datetime_consistency'
add_check_constraint :site_custom_variables, 'variable_type != 3 OR (text_value IS NOT NULL AND boolean_value IS NULL AND datetime_value IS NULL)', name: 'chk_site_custom_variables_text_consistency'
