create_table :accessible_contents, force: :cascade do |t|
  t.uuid :tenant_id, null: false
  t.uuid :user_id, null: false
  t.uuid :content_id, null: false

  t.timestamps null: false
end

add_foreign_key :accessible_contents, :users, column: [:tenant_id, :user_id], primary_key: [:tenant_id, :id]
add_foreign_key :accessible_contents, :content_entries, column: [:tenant_id, :content_id], primary_key: [:tenant_id, :id]
