create_table :content_type_field_select_options, force: :cascade do |t|
  t.bigint :field_select_id, null: false
  t.text :display_name, null: false
  t.text :identifier, null: false
  t.integer :position, null: false, default: 0

  t.timestamps null: false
end

add_index :content_type_field_select_options, [:field_select_id, :position]
add_index :content_type_field_select_options, [:field_select_id, :identifier], unique: true

add_foreign_key :content_type_field_select_options, :content_type_field_selects,
                column: :field_select_id

# Add FK for default_option_id after options table exists
add_foreign_key :content_type_field_selects, :content_type_field_select_options,
                column: :default_option_id
