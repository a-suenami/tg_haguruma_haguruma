create_table :tenant_site_settings, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.string :tenant_id, null: false

  # Feature settings (to be migrated to pages table in future)
  # Structure: { "news": { "enabled": true, "label": "...", ... }, ... }
  t.jsonb :features, null: false, default: {}

  # Landing page settings (to be migrated to pages table in future)
  # Structure: { "sections_order": [...], "external_link": { ... } }
  t.jsonb :landing, null: false, default: {}

  # Footer main links (replaces enabled_features in footer)
  # Structure: [{ "label": "...", "url": "...", "show_pc": true, "show_sp": false, "position": N, "is_logout": false }]
  t.jsonb :footer_main_links, null: false, default: []

  # Footer sub links (legal links area)
  # Structure: [{ "label": "...", "url": "...", "show_pc": true, "show_sp": true, "position": N }]
  t.jsonb :footer_sub_links, null: false, default: []

  # Unified menu items (features + custom links combined)
  # Structure: [{ "type": "feature"|"custom", "key": "...", "enabled": true, "label": "...", "menu_label": "...", "url": "...", "position": N }]
  t.jsonb :menu_items, null: false, default: []

  # Auth button labels
  t.string :login_label, null: false, default: 'ログイン'
  t.string :signup_label, null: false, default: '新規会員登録'

  t.timestamps null: false
end

add_index :tenant_site_settings, [:tenant_id], unique: true
add_foreign_key :tenant_site_settings, :tenants, column: :tenant_id, primary_key: :id
