create_table :admins, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :string, null: false
  t.string :name

  t.timestamps null: false

  t.index :tenant_id, name: :idx_admins_tenant_id, using: :btree
end

add_foreign_key :admins, :tenants, name: :fk_admins_tenants
