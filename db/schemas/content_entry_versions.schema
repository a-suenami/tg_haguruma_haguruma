create_table :content_entry_versions, force: :cascade do |t|
  t.citext :tenant_id, null: false
  t.uuid :content_type_id, null: false
  t.uuid :content_entry_id, null: false
  t.integer :version, null: false, default: 1
  t.integer :status, null: false
  t.boolean :is_public, null: false, default: false
  t.integer :visibility, null: false, default: 0
  t.datetime :created_at, null: false
  t.datetime :published_at
  t.datetime :unpublished_at
  t.string :preview_token # Token for preview access (draft content)
  t.datetime :preview_token_expires_at
end

add_index :content_entry_versions, [:tenant_id, :content_type_id, :content_entry_id, :version], unique: true, name: 'index_content_entry_versions_on_tenant_type_entry_version'
add_index :content_entry_versions, [:content_entry_id, :version], unique: true, name: 'index_content_entry_versions_on_entry_version'
add_index :content_entry_versions, [:tenant_id, :is_public], name: 'index_content_entry_versions_on_tenant_is_public'
add_index :content_entry_versions, [:tenant_id, :visibility], name: 'index_content_entry_versions_on_tenant_visibility'

# Only one draft version per content_entry
add_index :content_entry_versions, [:content_entry_id], unique: true, where: 'status = 1', name: 'index_content_entry_versions_unique_draft_per_entry'
# Only one published version per content_entry
add_index :content_entry_versions, [:content_entry_id], unique: true, where: 'status = 3', name: 'index_content_entry_versions_unique_published_per_entry'

# Index for preview token lookup
add_index :content_entry_versions, [:preview_token], unique: true, where: 'preview_token IS NOT NULL', name: 'index_content_entry_versions_on_preview_token'

# Index for expired token cleanup queries
add_index :content_entry_versions, [:preview_token_expires_at], where: 'preview_token IS NOT NULL', name: 'index_content_entry_versions_on_token_expires_at'

add_foreign_key :content_entry_versions, :content_entries, column: [:tenant_id, :content_type_id, :content_entry_id], primary_key: [:tenant_id, :content_type_id, :id],
name: 'fk_content_entry_versions_content_entries'
